// RouteIQ v1.3 schema — see CLAUDE.md section 5
// Every business table has tenantId. All reads/writes go through tenantDb() wrapper.

// NOTE: postgis extension declaration is intentionally omitted. Production Railway runs
// postgres-ssl:18 (PostGIS not guaranteed; nothing queries it); the init migration only tries
// CREATE EXTENSION and tolerates its absence (its comment about a PostGIS image is outdated). When developing
// locally with a PostGIS-equipped DB, re-add:
//   extensions = [postgis(map: "postgis")]
// to the datasource and:
//   previewFeatures = ["postgresqlExtensions"]
// to the generator.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  PLANNER
  SUPERVISOR
  VIEWER
}

enum CapacityUnit {
  CASES
  CARTONS
  PALLETS
  KG
}

enum OptimizationMode {
  MIN_TRUCKS
  MIN_DISTANCE
  MIN_COST
  BALANCED
  MAX_UTILIZATION
}

enum OrderStatus {
  UPLOADED
  VALIDATED
  ASSIGNED
  DISPATCHED
  DELIVERED
  FAILED
  UNSERVED
}

enum RunStatus {
  DRAFT
  OPTIMIZING
  READY
  FAILED
  DISPATCHED
  ARCHIVED
  // A newer plan version (late order / re-plan) replaced this one. Kept for traceability.
  SUPERSEDED
}

// NMWC dispatch MVP ----------------------------------------------------------------------
// One physical load of one truck. Lifecycle: PLANNED -> LOCKED -> LOADING -> DISPATCHED ->
// COMPLETED. PLANNED loads may be re-optimized; LOCKED/LOADING loads are kept verbatim by a
// re-plan unless explicitly unlocked; DISPATCHED/COMPLETED loads are immutable.
enum LoadStatus {
  PLANNED
  LOCKED
  LOADING
  DISPATCHED
  COMPLETED
}

enum PlanReason {
  INITIAL
  LATE_ORDER
  MANUAL_ADJUSTMENT
  REOPTIMIZE
}

enum CustomerType {
  HYPERMARKET
  SUPERMARKET
  TRADING
  CATERING
  HORECA
  GROCERY
  WHOLESALE
  OTHER
}

enum LocationSource {
  IMPORT
  MANUAL_LATLNG
  GOOGLE_MAPS_URL
  MAP_PIN
  GEOCODER
  CRM
}

enum PaymentType {
  CASH
  CREDIT
  PREPAID
}

enum UploadBatchStatus {
  PARSED
  VALIDATED
  CONFIRMED
  REJECTED
  DELETED
}

enum RunJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum UnservedReasonCode {
  MISSING_COORDINATES
  EXCEEDS_TRUCK_CAPACITY
  NO_AVAILABLE_TRUCK
  SHIFT_TIME_LIMIT
  INVALID_CUSTOMER
  SOLVER_DROPPED_LOW_PRIORITY
  INFEASIBLE_ROUTE
  UNKNOWN
  // dispatch MVP
  INVALID_LOCATION
  UNKNOWN_CUSTOMER
  UNKNOWN_PRODUCT
  EXCEEDS_ANY_TRUCK_CAPACITY
  HARD_WINDOW_INFEASIBLE
  SHIFT_LIMIT
  TRIP_LIMIT
  LOCKED_PLAN_CONFLICT
  LATE_ORDER_NO_CAPACITY
  ROUTING_PROVIDER_FAILURE
  INFEASIBLE
}

enum DistanceProvider {
  HAVERSINE
  MAPBOX_MATRIX
  OSRM
}

model Tenant {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  country     String
  currency    String        @default("OMR")
  primaryUnit CapacityUnit  @default(CASES)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  config      TenantConfig?

  users                User[]
  depots               Depot[]
  trucks               Truck[]
  drivers              Driver[]
  regions              Region[]
  customers            Customer[]
  products             Product[]
  uploadBatches        UploadBatch[]
  orders               Order[]
  runs                 RunPlan[]
  runJobs              RunJob[]
  manualBaselines      ManualBaseline[]
  audits               AuditLog[]
  passwordResets       PasswordResetToken[]
  driverShifts         DriverShift[]
  truckLocations       TruckLocation[]
  deliveryProofs       DeliveryProof[]
  customerTypeProfiles CustomerTypeProfile[]
  planLoads            PlanLoad[]
  intakeLineKeys       IntakeLineKey[]
  driverLinks          DriverLink[]
  stopVisits           StopVisit[]
  stopEvents           StopEvent[]
  deliveryPhotos       DeliveryPhoto[]
  hireOptions          HireOption[]
  hireSuggestions      HireSuggestion[]
  driverLeaves         DriverLeave[]
}

model TenantConfig {
  id                          String           @id @default(cuid())
  tenantId                    String           @unique
  tenant                      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avgSpeedKmh                 Float            @default(40)
  distanceProvider            DistanceProvider @default(OSRM)
  distanceMultiplier          Float            @default(1.30)
  // TODO v2: replace single tenant-wide multiplier with per-region overrides (RegionDistanceConfig).
  // City centers (Muscat) typically need ~1.4-1.5, highway regions (Duqm) ~1.1-1.2.
  // v2 should auto-calibrate from ManualBaseline.manual_distance_km vs Haversine-estimated distance.
  /// @deprecated Not read by the dispatch planner (estimated distances are always labelled). Hidden
  /// from Settings since stabilization PR5; dropped in a later expand-then-contract release.
  labelEstimatedDistances     Boolean          @default(true)
  driverShiftMaxMinutes       Int              @default(540)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  returnToDepot               Boolean          @default(true)
  defaultServiceTimeMin       Int              @default(10)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  costPerKmDefault            Float            @default(0.15)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  fixedTruckCostPerDayDefault Float            @default(20)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  latePenaltyPerMin           Float            @default(0.5)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  underutilizationPenalty     Float            @default(0)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  solverTimeLimitSeconds      Int              @default(30)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveTrucks       Float            @default(1000)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveDistance     Float            @default(1)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveCost         Float            @default(0)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveBalance      Float            @default(0)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveUtilization  Float            @default(0)

  // --- NMWC dispatch MVP (all times are minutes from local midnight) ---
  timezone                String  @default("Asia/Muscat")
  planningCutoffMin       Int     @default(1080) // orders after 18:00 the day before = LATE
  shiftStartMin           Int     @default(360) // earliest first departure 06:00
  reloadMinutes           Int     @default(30) // depot turnaround between loads
  loadingMinPerCase       Float   @default(0) // + loading time per case of the next load (0.04 -> 1,100 cases = 44 min)
  serviceMinPerCase       Float   @default(0) // + unloading time per case at the customer, on top of its service time
  maxTripsPerTruck        Int     @default(3)
  fuelPricePerLitre       Float   @default(0) // OMR; 0 = fuel not costed separately
  driverCostPerHour       Float   @default(0)
  overtimeAfterMin        Int     @default(540)
  // Driver break (owner rule 29-30 Sep 2026): one break per truck-day that works through midday,
  // STARTING between driverBreakFromMin and driverBreakToMin (minutes from midnight), on the road
  // between stops or at the depot (it may overlap reloading), never while unloading; inside the
  // shift, paid. 0 = no break (the default: the dispatcher turns it on in Settings after deploy).
  driverBreakMinutes      Int     @default(0)
  driverBreakFromMin      Int     @default(720)
  driverBreakToMin        Int     @default(840)
  overtimeCostPerHour     Float   @default(0)
  // Owner answer 4 (6 Oct 2026): the casual driver of a truck hired for the day (the hire suggestion) is
  // paid this per day (OMR), fixed, instead of driverCostPerHour and overtime; own trucks keep theirs. A
  // rough 10 OMR until the owner sets it (company admin, Settings). 0-1000 (database CHECK).
  dailyDriverDayRate      Float   @default(10)
  prefWindowPenaltyPerMin Float   @default(0.05)
  roadTimeFactor          Float   @default(1.25) // trucks vs cars on OSRM durations
  splitDeliveries         Boolean @default(true) // customers bigger than the largest truck are delivered in parts
  // Pallet fill (owner decision 4 Oct 2026): the percent of a truck's bays the planner may fill with
  // mixed pallets. 100 = every bay (the default, owner decision); lower = a safety margin (12 bays at
  // 95% = 11.4 pallets). 50-100 (database CHECK).
  palletFillPct           Int     @default(100)
  osrmUrl                 String? // overrides the OSRM_URL env var; there is no silent public default
  priorityWeightsJson     Json? // {"1":10000,...,"5":1}; must be strictly decreasing
  orderColumnMapJson      Json? // extra header aliases for the NMWC order export
  dateOrder               String  @default("DMY") // how to read 03/04/2026
  serviceAreaJson         Json? // {"minLat":..,"maxLat":..,"minLng":..,"maxLng":..} location sanity box
  // Owner decisions 1 Oct 2026 (data collection, items 3 and 4). Loading gate: when on, a load is
  // locked, loaded or dispatched only when every customer on it has a usable location and a delivery
  // window (its own confirmed hours, or a delivery time on the order). Off by default: the dispatcher
  // or admin switches it on at launch. Planning is never refused by it.
  requireDataBeforeLoading Boolean @default(false)
  // Data to collect: customers with open orders from today to this many days ahead that miss a
  // location or their own confirmed receiving hours.
  dataCollectDays          Int     @default(3)
  // Delivery outcome and the driver page (owner request 4 Oct 2026). Admin settings.
  // Radius around a stop's pin inside which the driver page counts the truck as arrived (50-500 m).
  geofenceRadiusM          Int      @default(100)
  // Delivered and Partly delivered need a photo from the driver (one exception: "Camera not working").
  photoProofRequired       Boolean  @default(true)
  // Delivery photo bytes are dropped after this many days (the metadata stays), 30-1095. Owner
  // decision 1 (5 Oct 2026): 90 days (it was 365; migration 20261005090000 moved companies on 365).
  photoRetentionDays       Int      @default(90)
  // Positions, IP addresses and browser ids of driver events and photos are erased after this many
  // days (30 .. photoRetentionDays); the distances from the pin are kept.
  locationRetentionDays    Int      @default(90)
  // The company number behind the driver page's "Call dispatcher" button: used when the truck's depot
  // has no number of its own (Depot.dispatcherPhone, owner decision 3 of 5 Oct 2026); hidden while
  // neither has one.
  dispatcherPhone          String?
  // Deliveries before this moment are outside the no-result list and the outcome KPIs (set to the
  // migration time for existing companies).
  outcomesSince            DateTime @default(now())
}

// Defaults per customer type; a customer's own values always win.
model CustomerTypeProfile {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerType       CustomerType
  defaultPriority    Int?
  serviceTimeMin     Int?
  hardWindowStartMin Int?
  hardWindowEndMin   Int?
  prefWindowStartMin Int?
  prefWindowEndMin   Int?

  @@unique([tenantId, customerType])
}

model User {
  id                   String               @id @default(cuid())
  tenantId             String?
  tenant               Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                String               @unique
  passwordHash         String
  name                 String
  role                 Role                 @default(VIEWER)
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  uploadBatches        UploadBatch[]
  runJobs              RunJob[]
  manualBaselines      ManualBaseline[]
  audits               AuditLog[]
  routeAssignmentLocks RouteAssignment[]    @relation("RouteAssignmentLockedBy")
  passwordResets       PasswordResetToken[]
  verifiedLocations    Customer[]           @relation("CustomerLocationVerifiedBy")
  lateOrders           Order[]              @relation("OrderLateRecordedBy")
  loadStatusChanges    PlanLoad[]           @relation("PlanLoadStatusBy")
  loadDriversSet       PlanLoad[]           @relation("PlanLoadDriverSetBy")
  ordersCarried        Order[]              @relation("OrderCarriedBy")
  confirmedWindows     Customer[]           @relation("CustomerWindowConfirmedBy")
  orderTimesSet        Order[]              @relation("OrderDeliveryTimeSetBy")
  driverLinksIssued    DriverLink[]         @relation("DriverLinkIssuedBy")
  driverLinksRevoked   DriverLink[]         @relation("DriverLinkRevokedBy")
  stopOutcomesSet      StopVisit[]          @relation("StopVisitOutcomeBy")
  stopEvents           StopEvent[]          @relation("StopEventUser")
  deliveryPhotos       DeliveryPhoto[]      @relation("DeliveryPhotoUser")
  driverLeavesAdded    DriverLeave[]        @relation("DriverLeaveCreatedBy")
  driverLeavesChanged  DriverLeave[]        @relation("DriverLeaveUpdatedBy")

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Depot {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  lat           Float
  lng           Float
  address       String?
  active        Boolean       @default(true)
  openMin       Int? // depot opening, minutes from midnight; null = 00:00
  closeMin      Int? // depot closing; null = 24:00
  /// Audit PR A5: a depot that only keeps the orders and order files that had no depot before the
  /// owner rule "every order has a depot" (migration 20260930120000_orders_always_have_depot, code
  /// NO-DEPOT). Always inactive: never offered in a picker, never planned, and the app refuses to
  /// make it active or to put a truck or region on it. The database refuses it too (CHECK
  /// "Depot_historyOnly_not_active", in that migration; Prisma's schema has no CHECK constraints).
  historyOnly   Boolean       @default(false)
  /// Owner decision 3 (5 Oct 2026): the number behind the driver page's "Call dispatcher" for the
  /// trucks of this depot (company admin, Depots page). Null: the company number
  /// (TenantConfig.dispatcherPhone). lib/driver-link/dispatcher-phone.ts.
  dispatcherPhone String?
  trucks        Truck[]
  regions       Region[]
  runs          RunPlan[]
  orders        Order[]
  uploadBatches UploadBatch[]
  hireOptions   HireOption[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Truck {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId          String
  depot            Depot             @relation(fields: [depotId], references: [id])
  code             String
  description      String?
  capacityCases    Int               @default(0)
  capacityWeightKg Float             @default(0)
  capacityVolumeL  Float             @default(0)
  fixedCostPerDay  Float             @default(0) // fixed operating cost per day the truck is used
  costPerKm        Float             @default(0) // variable cost/km EXCLUDING fuel when kmPerLitre is set
  kmPerLitre       Float? // fuel economy: fuel cost = km / kmPerLitre x fuel price
  /// Bays (pallet positions, owner decision 4 Oct 2026): set = the truck is planned by PALLETS
  /// (bays x TenantConfig.palletFillPct and the payload; capacityCases is then not a limit);
  /// null = planned by cases (capacityCases). The column kept its first name.
  bays             Int?              @map("palletCapacity")
  tripCost         Float             @default(0) // per load (loading labour etc.)
  maxTripsPerDay   Int? // overrides TenantConfig.maxTripsPerTruck
  availableFromMin Int?
  availableToMin   Int?
  defaultDriverId  String?
  /// NO ACTION (audit F20): a driver still set as a truck's default is never deleted (drivers are deactivated).
  defaultDriver    Driver?           @relation("TruckDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: NoAction)
  active           Boolean           @default(true)
  /// Hired from outside (owner request 4 Oct 2026): a badge on the plan, the driver sheets and the
  /// driver page. The planner never reads it.
  hired            Boolean           @default(false)
  /// A one-day truck (owner request 6 Oct 2026, the hire suggestion's "Use this plan"): available on
  /// this delivery date only - every plan of another day leaves it out, and the janitor retires it
  /// (active false) once the day is over. Null: an ordinary truck, every day.
  onlyOnDate       DateTime?         @db.Date
  /// The hire option a one-day truck was rented from (its max per day counts it).
  hireOptionId     String?
  hireOption       HireOption?       @relation(fields: [hireOptionId], references: [id], onDelete: SetNull)
  routes           RouteAssignment[]
  shifts           DriverShift[]
  locations        TruckLocation[]
  loads            PlanLoad[]
  driverLinks      DriverLink[]
  stopVisits       StopVisit[]

  @@unique([tenantId, code])
  @@index([tenantId, depotId])
  @@index([tenantId, onlyOnDate])
}

/// A truck the company can rent for a day (owner request 6 Oct 2026, the hire suggestion): company
/// admin, Trucks page, per depot. When a plan leaves orders out because the fleet cannot carry them,
/// a what-if optimization adds one truck per unit (maxPerDay) and says which ones to rent
/// (lib/dispatch/hire.ts). Nothing is seeded: the admin enters the company's own figures.
model HireOption {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId       String
  depot         Depot    @relation(fields: [depotId], references: [id])
  /// "10-ton", "3-ton": the dispatcher reads it in the suggestion and the truck codes (HIRE-10T-...).
  label         String
  /// Pallet positions (planned by pallets, like a truck with bays); null = planned by capacityCases.
  bays          Int?
  capacityCases Int      @default(0)
  /// Payload in kg; 0 = no weight limit.
  payloadKg     Float    @default(0)
  /// The hire for one day (OMR): the rented truck's fixed cost per day.
  costPerDay    Float
  /// The rental's own charge per km (OMR), if it has one; null = none (0). Fuel is in the hire (owner
  /// answer 3, 6 Oct 2026): a rented truck never costs fuel or the fleet's km rate.
  costPerKm     Float?
  /// How many of this truck the company can rent on one day (1-10).
  maxPerDay     Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trucks        Truck[]

  @@unique([tenantId, depotId, label])
  @@index([tenantId, depotId])
}

/// One what-if optimization of the hire suggestion (owner request 6 Oct 2026): the plan version it
/// was computed for, its own job state (never the plan's RunJob: it never delays or changes the
/// dispatcher's plan), the request and the answer, and the suggestion the dispatcher reads
/// (summaryJson, lib/dispatch/hire.ts). usedAt / usedRunId: "Use this plan" made that version.
model HireSuggestion {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId        String
  run          RunPlan      @relation(fields: [runId], references: [id], onDelete: Cascade)
  status       RunJobStatus @default(QUEUED)
  /// AFTER_PLAN (started by a plan that left orders out) or ASKED ("Check hire options").
  trigger      String
  message      String?
  /// What the plan in use left out, the request's fingerprint and the hire options as they were.
  basisJson    Json
  requestJson  Json?
  responseJson Json?
  summaryJson  Json?
  errorJson    Json?
  createdById  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?    @db.Timestamptz(3)
  finishedAt   DateTime?    @db.Timestamptz(3)
  heartbeatAt  DateTime?    @db.Timestamptz(3)
  usedAt       DateTime?    @db.Timestamptz(3)
  usedById     String?
  usedRunId    String?

  @@index([tenantId, runId])
  @@index([tenantId, status])
}

model Driver {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  phone         String?
  // Module C: drivers sign into the PWA with tenant slug + driver code + 6-char PIN.
  // PIN is stored hashed (bcrypt cost 12, same as User passwords). Null until set.
  accessPinHash String?
  active        Boolean @default(true)
  /// A daily (casual) driver added from a load by the dispatcher (owner request 4 Oct 2026). No
  /// account; an admin may clear it to make them a regular driver.
  casual        Boolean @default(false)

  shifts        DriverShift[]
  defaultTrucks Truck[]       @relation("TruckDefaultDriver")
  loads         PlanLoad[]
  leaves        DriverLeave[] @relation("DriverLeaveOf")
  covers        DriverLeave[] @relation("DriverLeaveCover")

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// A driver's leave (owner request 6 Oct 2026: the dispatcher follows who is away). From and until
/// are delivery dates, both included. On those days RouteIQ never puts the driver on a load; a truck
/// whose usual (default) driver is away gets the cover driver when he is free that day (planDrivers,
/// lib/dispatch/driver-leave.ts). One driver's periods never overlap (checked under the driver's row
/// lock); a period that has started keeps its first day, and one that has ended is kept for the record.
model DriverLeave {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId      String
  /// NO ACTION, as every other reference to a driver (migration 20260930093000_master_data_no_orphans):
  /// a driver is only ever deleted by Start fresh, which keeps a daily driver named by any leave
  /// period (his own or as the cover), so leave and its record never change silently.
  driver        Driver   @relation("DriverLeaveOf", fields: [driverId], references: [id], onDelete: NoAction)
  fromDate      DateTime @db.Date
  untilDate     DateTime @db.Date
  note          String?
  coverDriverId String?
  /// NO ACTION too (see driverId).
  coverDriver   Driver?  @relation("DriverLeaveCover", fields: [coverDriverId], references: [id], onDelete: NoAction)
  createdById   String?
  createdBy     User?    @relation("DriverLeaveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedById   String?
  updatedBy     User?    @relation("DriverLeaveUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt

  @@index([tenantId, untilDate])
  @@index([driverId, fromDate])
}

// Module C — driver tracking.
//
// A DriverShift is one driver's work session on one truck for one RunPlan. It
// scopes GPS pings, deliveries, and proof-of-delivery records. Status moves
// ACTIVE → COMPLETED on shift end (or ABANDONED if the janitor closes a stale one).
enum DriverShiftStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model DriverShift {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId     String
  driver       Driver            @relation(fields: [driverId], references: [id])
  truckId      String
  truck        Truck             @relation(fields: [truckId], references: [id])
  runId        String?
  run          RunPlan?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  // Opaque token the driver PWA holds; required on every GPS-ping call.
  sessionToken String            @unique
  status       DriverShiftStatus @default(ACTIVE)
  startedAt    DateTime          @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?         @db.Timestamptz(3)
  notes        String?
  locations    TruckLocation[]
  proofs       DeliveryProof[]

  @@index([tenantId, status])
  @@index([truckId, status])
  @@index([driverId, status])
  @@index([runId])
}

// One GPS sample. Pings flow ~every 30s from the PWA. We persist all of them so
// the dispatcher view can replay actuals vs planned, and so route-deviation
// analytics works retroactively. A daily janitor archives rows older than 30 days.
model TruckLocation {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck       @relation(fields: [truckId], references: [id])
  ts         DateTime    @db.Timestamptz(3)
  lat        Float
  lng        Float
  speedKmh   Float?
  headingDeg Float?
  accuracyM  Float?
  batteryPct Int?

  @@index([tenantId, truckId, ts])
  @@index([shiftId, ts])
}

// Per-stop completion record. POD = proof of delivery. v1 stores notes + a
// signature blob (base64 PNG, max ~50 KB). Photo upload is deferred to v2 when
// an object store (R2) is wired.
model DeliveryProof {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId         String
  shift           DriverShift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignmentId    String          @unique
  assignment      RouteAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  completedAt     DateTime        @default(now()) @db.Timestamptz(3)
  notes           String?
  signaturePngB64 String?
  lat             Float?
  lng             Float?

  @@index([tenantId, completedAt])
  @@index([shiftId])
}

model Region {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId   String?
  depot     Depot?     @relation(fields: [depotId], references: [id])
  code      String
  name      String
  customers Customer[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Customer {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regionId          String?
  region            Region?     @relation(fields: [regionId], references: [id])
  code              String
  name              String
  branchCode        String?
  branchKey         String      @default("__MAIN__")
  address           String?
  lat               Float?
  lng               Float?
  geocodeConfidence String?
  priority          Int         @default(3) // 1 = HIGHEST ... 5 = LOWEST
  avgServiceTimeMin Int         @default(10)
  paymentType       PaymentType @default(CREDIT)
  accessNotes       String?
  active            Boolean     @default(true)
  orders            Order[]

  // --- NMWC dispatch MVP ---
  customerType         CustomerType?
  priorityConfirmed    Boolean         @default(false) // false = default/type priority; ask the dispatcher
  serviceTimeConfirmed Boolean         @default(false)
  hardWindowStartMin   Int? // delivery outside the hard window is infeasible
  hardWindowEndMin     Int?
  prefWindowStartMin   Int? // outside the preferred window is allowed but penalised
  prefWindowEndMin     Int?
  locationInput        String? // what the dispatcher pasted (link / "lat,lng")
  locationSource       LocationSource?
  locationVerified     Boolean         @default(false)
  locationVerifiedById String?
  locationVerifiedBy   User?           @relation("CustomerLocationVerifiedBy", fields: [locationVerifiedById], references: [id], onDelete: SetNull)
  locationVerifiedAt   DateTime?
  createdFromUpload    Boolean         @default(false) // stub created from an order file
  /// Owner decision 1 Oct 2026 ("own confirmed window"): set when a dispatcher or admin entered or
  /// confirmed this customer's receiving hours (the four window columns; all four empty = open all
  /// day, any time). NULL = not confirmed: the hours in use are a default or were never checked.
  windowConfirmedAt    DateTime?
  windowConfirmedById  String?
  windowConfirmedBy    User?           @relation("CustomerWindowConfirmedBy", fields: [windowConfirmedById], references: [id], onDelete: SetNull)
  /// Owner decision 1 Oct 2026 (item 6, daily customer master): when the customer was created and last
  /// changed. NULL on customers from before this release (nothing recorded when they were made).
  createdAt            DateTime?       @default(now())
  updatedAt            DateTime?       @updatedAt
  stopVisits           StopVisit[]

  @@unique([tenantId, code, branchKey])
  @@index([tenantId, regionId])
  @@index([tenantId, updatedAt])
}

model Product {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  weightPerCaseKg   Float       @default(0) // 0 = unknown
  volumePerCaseL    Float       @default(0)
  unitsPerCase      Int?
  /// The ERP pallet factor (owner decision 4 Oct 2026): cases of this product on one pallet. A
  /// whole number 1-10,000 (lib/dispatch/pallets.ts validPalletFactor; anything else counts as
  /// missing). Needed on every product of a day planned with trucks that have bays.
  casesPerPallet    Float?
  createdFromUpload Boolean     @default(false)
  active            Boolean     @default(true)
  orderLines        OrderLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UploadBatch {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName       String
  fileType       String
  uploadedById   String
  uploadedBy     User              @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime          @default(now())
  deliveryDate   DateTime?         @db.Date
  status         UploadBatchStatus @default(PARSED)
  totalRows      Int               @default(0)
  validRows      Int               @default(0)
  errorRows      Int               @default(0)
  warningRows    Int               @default(0)
  validationJson Json?
  orders         Order[]
  // --- dispatch MVP ---
  /// Required (owner rule, audit PR A5): every order file is for one depot.
  depotId        String
  /// NO ACTION (audit F03): a depot with order files is never deleted (it is deactivated).
  depot          Depot             @relation(fields: [depotId], references: [id], onDelete: NoAction)
  fileHash       String?
  isLate         Boolean           @default(false)
  lateReason     String?

  @@index([tenantId, uploadedAt])
  @@index([tenantId, fileHash])
}

model Order {
  id                        String                     @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer                   @relation(fields: [customerId], references: [id])
  deliveryDate              DateTime                   @db.Date
  totalCases                Int                        @default(0)
  totalWeightKg             Float                      @default(0)
  totalVolumeL              Float                      @default(0)
  totalServiceTimeMin       Int                        @default(10)
  priority                  Int                        @default(3)
  paymentCollectionAmount   Float                      @default(0)
  notes                     String?
  status                    OrderStatus                @default(UPLOADED)
  uploadBatchId             String?
  uploadBatch               UploadBatch?               @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  uploadedAt                DateTime                   @default(now())
  lines                     OrderLine[]
  assignments               RouteAssignment[]
  unservedRecords           UnservedOrder[]
  manualBaselineAssignments ManualBaselineAssignment[]
  // --- dispatch MVP (uploadedAt = received time) ---
  /// Required (owner rule "all orders must have depots linked to them", audit PR A5).
  depotId                   String
  /// NO ACTION (audit F03): a depot with orders is never deleted (it is deactivated), so an order
  /// never loses its depot and never moves into another depot's plan.
  depot                     Depot                      @relation(fields: [depotId], references: [id], onDelete: NoAction)
  isLate                    Boolean                    @default(false)
  lateReason                String?
  lateRecordedById          String?
  lateRecordedBy            User?                      @relation("OrderLateRecordedBy", fields: [lateRecordedById], references: [id], onDelete: SetNull)
  salesValue                Float?
  marginValue               Float?
  priorityFromFile          Boolean                    @default(false) // true = `priority` came from the order file
  // --- Bring forward (PR9): an order not delivered on its own day, carried to a later day ---
  /// On the copy: the order it was brought forward from (one copy per order: unique).
  carriedFromOrderId        String?                    @unique
  carriedFrom               Order?                     @relation("OrderCarriedFrom", fields: [carriedFromOrderId], references: [id], onDelete: NoAction)
  carriedFromCopy           Order?                     @relation("OrderCarriedFrom")
  /// On the copy: the delivery date the order was first due (the first order's date when carried more than once).
  carriedFromDate           DateTime?                  @db.Date
  /// On the original: its copy on the later day. Set = no longer open, unserved or pending on its own day.
  carriedToOrderId          String?                    @unique
  carriedTo                 Order?                     @relation("OrderCarriedTo", fields: [carriedToOrderId], references: [id], onDelete: NoAction)
  carriedToOrigin           Order?                     @relation("OrderCarriedTo")
  carriedAt                 DateTime?
  carriedById               String?
  carriedBy                 User?                      @relation("OrderCarriedBy", fields: [carriedById], references: [id], onDelete: SetNull)
  // --- Delivery time for this one order (owner decision 1 Oct 2026): urgent or promised. It replaces
  // the customer's receiving hours for this order only; the customer master is not changed. Minutes
  // from local midnight; one end may be empty ("by 10:00", "from 14:00"); both empty = none.
  deliveryStartMin          Int?
  deliveryEndMin            Int?
  /// URGENT | PROMISED | OTHER (lib/dispatch/order-window.ts).
  deliveryTimeReason        String?
  deliveryTimeNote          String?
  deliveryTimeSetAt         DateTime?
  deliveryTimeSetById       String?
  deliveryTimeSetBy         User?                      @relation("OrderDeliveryTimeSetBy", fields: [deliveryTimeSetById], references: [id], onDelete: SetNull)
  /// On a brought-forward copy: the delivery results (visits and not-delivered cases per line) the
  /// carry was based on (owner request 4 Oct 2026). Null on copies made from other reasons or before.
  carryBasisJson            Json?

  @@index([tenantId, deliveryDate])
  @@index([tenantId, customerId])
  @@index([tenantId, depotId, deliveryDate])
  // An order file's orders: the file delete, the files list's order counts and the SET NULL key
  // when a file row itself is deleted (review db-schema-1).
  @@index([uploadBatchId])
}

model OrderLine {
  id                 String         @id @default(cuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product        @relation(fields: [productId], references: [id])
  cases              Int
  // --- dispatch MVP: keep sales-order / SKU detail so manifests reconcile exactly ---
  salesOrderNo       String?
  orderDate          DateTime?      @db.Date
  productDescription String?
  weightKg           Float          @default(0) // 0 = unknown
  /// The line's kg is (to be) cases x the product's case weight: the file gave no weight for it.
  /// Such a line follows the product master: a case weight entered or corrected later is applied
  /// at the next optimize / re-plan (unless the line is on a frozen load). File weights are kept.
  weightFromMaster   Boolean        @default(false)
  salesValue         Float?
  marginValue        Float?
  sourceRow          Int?
  notes              String?
  intakeKey          IntakeLineKey?

  @@index([orderId])
  @@index([salesOrderNo])
}

/// Durable identity of a confirmed sales-order line (delivery date + sales order + customer +
/// product), so the same line can never be confirmed twice: from two files, two tabs or a late
/// order. Lines without a sales-order number have no key (the file hash covers them). The key
/// goes away with its order line, so a permitted batch delete frees it for a re-upload.
model IntakeLineKey {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime  @db.Date
  salesOrderNorm String // sales-order number, trimmed and upper-case
  customerId     String
  productId      String
  orderLineId    String    @unique
  orderLine      OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  uploadBatchId  String? // null = late order recorded on the plan
  createdAt      DateTime  @default(now())

  @@unique([tenantId, deliveryDate, salesOrderNorm, customerId, productId])
  @@index([tenantId, salesOrderNorm])
}

model RunPlan {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId            String
  depot              Depot             @relation(fields: [depotId], references: [id])
  runDate            DateTime          @db.Date
  status             RunStatus         @default(DRAFT)
  optimizationMode   OptimizationMode  @default(BALANCED)
  chosenScenarioId   String?
  totalOrders        Int               @default(0)
  unservedCount      Int               @default(0)
  createdById        String
  createdAt          DateTime          @default(now())
  finalizedAt        DateTime?
  scenarios          ScenarioResult[]
  routes             RouteAssignment[]
  currentJobId       String?
  jobs               RunJob[]
  manualBaselines    ManualBaseline[]
  driverShifts       DriverShift[]
  // --- dispatch MVP: plan versions (a plan is never overwritten invisibly) ---
  version            Int               @default(1)
  parentRunId        String?
  parentRun          RunPlan?          @relation("PlanVersions", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns          RunPlan[]         @relation("PlanVersions")
  reason             PlanReason        @default(INITIAL)
  reasonNote         String?
  supersededAt       DateTime?
  changeSummaryJson  Json?
  reconciliationJson Json?
  summaryJson        Json?
  /// Timetable check of this version's loads per truck-day (lib/dispatch/feasibility.ts): what
  /// LOCK / LOADING / DISPATCH are gated on. Null for versions made before it existed (computed
  /// on the next load change).
  feasibilityJson    Json?
  loads              PlanLoad[]
  hireSuggestions    HireSuggestion[]

  @@index([tenantId, runDate])
  @@index([tenantId, currentJobId])
  @@index([tenantId, depotId, runDate, version])
}

model PlanLoad {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId               String
  run                 RunPlan           @relation(fields: [runId], references: [id], onDelete: Cascade)
  truckId             String
  truck               Truck             @relation(fields: [truckId], references: [id])
  loadNo              Int
  status              LoadStatus        @default(PLANNED)
  driverId            String?
  /// NO ACTION (audit F20): a driver on a load is never deleted (drivers are deactivated), so a
  /// load never loses who drove it.
  driver              Driver?           @relation(fields: [driverId], references: [id], onDelete: NoAction)
  departMin           Int
  returnMin           Int
  distanceKm          Float
  durationMin         Int
  cases               Int
  weightKg            Float
  utilizationPct      Float
  fuelLitres          Float?
  fuelCost            Float             @default(0)
  operatingCost       Float             @default(0)
  returnLegKm         Float             @default(0)
  distanceIsEstimated Boolean           @default(true)
  /// The truck and planning rules this load was timed with (code, capacities, costs, availability,
  /// turnaround / shift / depot hours): lib/dispatch/snapshots.ts. Null on loads planned before
  /// snapshots existed (the live truck is shown, labelled as such).
  truckSnapshotJson   Json?
  // The driver break planned with this load (v1: startMin, endMin, lengthMin, where DEPOT | ROAD,
  // afterSequence), or NULL. Copied with the load into every new version, so a locked load keeps it.
  breakJson           Json?
  /// The pallet need the load was planned with, in 1/1000 pallet (the sum of its rows'): set only
  /// on a load planned by pallets (a truck with bays, and the optimizer said so). NULL = planned by
  /// cases, or before pallets existed. Copied unchanged with a frozen load.
  palletUnits         Int?
  /// The load's cost breakdown under the one cost model (review F17, apps/solver/costing.py: the
  /// driver is paid for the whole truck day): fixed, trip, distance, fuel, driver share, overtime,
  /// paid minutes, estimated legs (lib/dispatch/costs.ts). Null on loads costed the earlier way
  /// (operatingCost then excludes depot turnaround, waiting and overtime).
  costJson            Json?
  carriedFromLoadId   String? // the same physical load in the parent plan version
  statusChangedAt     DateTime?
  statusChangedById   String?
  statusChangedBy     User?             @relation("PlanLoadStatusBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  // Who last set the driver in the Driver list or with Keep, and when (setDriverTx; "No driver"
  // too, which is not a hand-set driver). Carried by a re-plan's copies, and with a driver by
  // applyScenario to the same truck and trip. Null: RouteIQ filled it in.
  driverSetById       String?
  driverSetBy         User?             @relation("PlanLoadDriverSetBy", fields: [driverSetById], references: [id], onDelete: SetNull)
  driverSetAt         DateTime?
  /// (6 Oct 2026, driver leave) RouteIQ gave this driver as the cover of the truck's usual driver on
  /// leave (planDrivers, pass 3). A re-plan offers him again only as the cover - so he goes when the
  /// leave ends early, another cover is named or he drives another truck that day. Copied by a
  /// re-plan's copies; false for every other driver and once the dispatcher sets the driver.
  driverIsCover       Boolean           @default(false)
  createdAt           DateTime          @default(now())
  assignments         RouteAssignment[]

  @@unique([runId, truckId, loadNo])
  @@index([tenantId, runId])
}

model ScenarioResult {
  id                String          @id @default(cuid())
  runId             String
  run               RunPlan         @relation(fields: [runId], references: [id], onDelete: Cascade)
  name              String
  trucksUsed        Int
  totalDistanceKm   Float
  totalTimeMin      Int
  totalCost         Float
  avgUtilizationPct Float
  unservedCount     Int
  detailsJson       Json
  unservedOrders    UnservedOrder[]
  createdAt         DateTime        @default(now())

  @@index([runId])
}

model RouteAssignment {
  id                        String         @id @default(cuid())
  runId                     String
  run                       RunPlan        @relation(fields: [runId], references: [id], onDelete: Cascade)
  truckId                   String
  truck                     Truck          @relation(fields: [truckId], references: [id])
  orderId                   String
  order                     Order          @relation(fields: [orderId], references: [id])
  sequenceInTruck           Int
  plannedArrivalMin         Int
  plannedDistanceFromPrevKm Float
  plannedLoadCases          Int
  lockedByUserId            String?
  lockedBy                  User?          @relation("RouteAssignmentLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  manualOverrideReason      String?
  deliveryProof             DeliveryProof?
  // --- dispatch MVP ---
  loadId                    String?
  load                      PlanLoad?      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  loadNo                    Int            @default(1)
  orderInStop               Int            @default(0) // several orders for one customer = one stop
  etaMin                    Int? // clock minutes from midnight
  serviceStartMin           Int?
  departureMin              Int?
  waitMin                   Int?
  cumulativeKm              Float?
  hardWindowOk              Boolean?
  prefWindowOk              Boolean?
  // --- split deliveries: a customer bigger than one truck is delivered in parts. A row with
  // portion fields carries only part of its order; null = the whole order. ---
  portionCases              Int?
  portionWeightKg           Float?
  portionLinesJson          Json? // [{ lineId, cases }] - exact SKU lines of this portion
  /// The row's pallet need as sent to the optimizer, in 1/1000 pallet (each line's cases / its cases
  /// per pallet, rounded up per line). NULL = planned without pallets (no truck with bays).
  palletUnits               Int?
  /// The customer facts this stop was planned with (pin, receiving hours, service time, name,
  /// address, access notes): lib/dispatch/snapshots.ts. Null on rows planned before snapshots
  /// existed (the live customer is shown, labelled as such).
  stopSnapshotJson          Json?

  @@unique([runId, truckId, loadNo, sequenceInTruck, orderInStop])
  @@index([runId, truckId])
  @@index([loadId])
  // The RESTRICT key on orderId: deleting an order looks here once per order. Every plan version
  // copies all its stops and nothing prunes them, so without this index a wrong file's delete
  // scanned the whole table per order and timed out after a few months (review db-schema-1).
  @@index([orderId])
}

model RunJob {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId        String
  run          RunPlan      @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptNo    Int          @default(1)
  status       RunJobStatus @default(QUEUED)
  progressPct  Int          @default(0)
  message      String?
  requestJson  Json?
  responseJson Json?
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?    @db.Timestamptz(3)
  finishedAt   DateTime?    @db.Timestamptz(3)
  errorJson    Json?
  /// QUICK or THOROUGH (owner decision 29 Sep 2026: night plans long, day re-plans quick). Null on
  /// jobs from before search modes (they searched QUICK).
  searchMode   String?
  /// The last sign of life of the web process running this job: written every 30 s while it waits
  /// for a solver slot or for the optimizer (lib/jobs/dispatch-job.ts). The stuck-plan check and
  /// the janitor use it, so a 20-minute search is never taken for a lost job.
  heartbeatAt  DateTime?    @db.Timestamptz(3)

  @@unique([runId, attemptNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([runId])
}

model ManualBaseline {
  id              String                     @id @default(cuid())
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId           String?
  run             RunPlan?                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  fileName        String?
  uploadedById    String
  uploadedBy      User                       @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime                   @default(now())
  totalTrucks     Int                        @default(0)
  totalDistanceKm Float?
  totalTimeMin    Int?
  totalCost       Float?
  notes           String?
  assignments     ManualBaselineAssignment[]

  @@index([tenantId, createdAt])
  @@index([tenantId, runId])
}

model ManualBaselineAssignment {
  id                  String         @id @default(cuid())
  baselineId          String
  baseline            ManualBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  orderId             String?
  order               Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  truckCode           String
  sequence            Int?
  customerCode        String
  branchKey           String         @default("__MAIN__")
  cases               Int            @default(0)
  estimatedDistanceKm Float?
  estimatedTimeMin    Int?

  @@index([baselineId, truckCode])
  // SET NULL on orderId: an order delete looks here once per order (review db-schema-1).
  @@index([orderId])
}

model UnservedOrder {
  id               String             @id @default(cuid())
  scenarioId       String
  scenario         ScenarioResult     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  orderId          String
  // NoAction: an order that is in any plan option cannot be deleted from under it (like
  // RouteAssignment.orderId). Deleting a tenant removes its plan data first.
  order            Order              @relation(fields: [orderId], references: [id], onDelete: NoAction)
  reasonCode       UnservedReasonCode
  reasonMessage    String?
  // Split deliveries: only part of the order is unserved (null = the whole order).
  portionCases     Int?
  portionWeightKg  Float?
  portionLinesJson Json? // [{ lineId, cases }]
  createdAt        DateTime           @default(now())

  @@index([scenarioId])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  // The Audit log page's user list (rows per user, read from this index alone) and the API's
  // filter by user, newest first (review db-schema-2).
  @@index([tenantId, userId, createdAt])
}

// --- Delivery outcome & driver page (owner request 4 Oct 2026) ---------------------------------
// One driver link (QR) per truck and delivery date opens the driver's phone page (app/d/[token]);
// arrivals, departures, results and photos are stop events. Spec: lib/driver-link/*, lib/delivery/*.
// The retired driver app's tables (DriverShift, TruckLocation, DeliveryProof) are not used.

enum StopEventKind {
  ARRIVED        // payload: chained?, observed (false = first seen when the page came back), resumed?
  DEPARTED       // payload: reason LEFT | NEXT_STOP, gap? (true = not observed: the page was away)
  OUTCOME        // payload: outcome (or null = result cleared), reason, note, lines, photoKeys, noPhotoReason?
  PHOTO          // payload: { photoId }
  BACK_AT_DEPOT  // load level: sequence is NULL
  CARRY_CONFLICT // a result change refused because the order was brought forward; ignored by deriveVisit
}

enum PhotoPositionStatus {
  OK             // a fix with accuracy <= 100 m
  POOR           // a fix, accuracy > 100 m
  DENIED         // location permission refused
  TIMEOUT        // no fix within 15 s
  UNSUPPORTED    // no Geolocation in this browser
}

enum StopEventSource {
  PHONE_AUTO     // the driver page's geofence (no tap)
  PHONE_MANUAL   // the driver tapped (I have arrived, a result, a photo, Back at depot)
  DISPATCHER     // recorded or corrected on the plan screen
  AYUN           // later: Ayun GPS stop events
  SYSTEM         // derived by RouteIQ (for example the janitor completing a returned load)
}

enum DeliveryOutcome {
  DELIVERED
  PARTLY_DELIVERED
  NOT_DELIVERED
}

enum NotDeliveredReason {
  SHOP_CLOSED
  CUSTOMER_REFUSED
  NO_ONE_TO_RECEIVE
  WRONG_LOCATION      // "Wrong location or could not find"
  NO_TIME_LEFT
  PAYMENT_ISSUE
  DAMAGED_GOODS
  NOT_ON_TRUCK        // cases missing from the truck
  OTHER               // note required
}

/// One driver link per truck and delivery date. The token is never stored: tokenHash is its
/// SHA-256 (lookup), and the token is re-derived on the server from (id, generation, salt) and the
/// server key (lib/driver-link/token.ts), so the plan screen and every PDF can show it again.
model DriverLink {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  truckId          String
  /// NO ACTION: a truck with links is deactivated, never deleted.
  truck            Truck           @relation(fields: [truckId], references: [id], onDelete: NoAction)
  deliveryDate     DateTime        @db.Date
  generation       Int             @default(1)
  salt             String // 16 random bytes, base64url; new on every reissue
  keyId            String // first 8 hex of SHA-256(server key): resolve refuses a link made with an older key
  tokenHash        String          @unique // SHA-256 hex of the token
  /// The hash of the generation before the last reissue: that token answers 410 LINK_REPLACED
  /// (never counted as a bad token) instead of 404.
  prevTokenHash    String?         @unique
  expiresAt        DateTime        @db.Timestamptz(3) // reading and new results; uploads get +72 h
  issuedAt         DateTime        @default(now()) @db.Timestamptz(3)
  issuedById       String?
  issuedBy         User?           @relation("DriverLinkIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  /// The driver of the truck-day's first load not yet COMPLETED when (re)issued: "Reissue link?" prompt.
  driverIdAtIssue  String?
  revokedAt        DateTime?       @db.Timestamptz(3)
  revokedById      String?
  revokedBy        User?           @relation("DriverLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  lastSeenAt       DateTime?       @db.Timestamptz(3)
  /// Up to 5 browsers seen with this generation: [{ device: first 8 hex of sha256(deviceId), first, last }]
  /// (written at most every 5 min). The link dialog shows "used on N phones".
  devicesJson      Json?
  events           StopEvent[]
  photos           DeliveryPhoto[]

  @@unique([tenantId, truckId, deliveryDate])
  @@index([tenantId, deliveryDate])
}

/// One physical stop of a load that left the depot: the current state, rebuilt from its events.
/// Keyed by the stop itself, never by a plan version's row (a re-plan copies the loads).
model StopVisit {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId             String
  deliveryDate        DateTime             @db.Date
  truckId             String
  truck               Truck                @relation(fields: [truckId], references: [id], onDelete: NoAction)
  loadNo              Int
  sequence            Int
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction)
  /// Traceability only (no FK): the PlanLoad row of the version the first event was recorded on.
  firstLoadId         String?
  // The plan as it was for this stop (copied at the first write; frozen loads never change):
  plannedEtaMin       Int?
  plannedServiceMin   Int? // departureMin - serviceStartMin (the scheduled unloading)
  plannedLat          Float?
  plannedLng          Float?
  windowStartMin      Int? // promised time, else the hard receiving window; null = any time
  windowEndMin        Int?
  /// [{ orderId, lineId, productCode, plannedCases, deliveredCases|null }] (readVisitLines)
  linesJson           Json
  casesPlanned        Int
  casesDelivered      Int? // null = no result
  // Timing (rebuilt from events):
  arrivedAt           DateTime?            @db.Timestamptz(3)
  arrivalSource       StopEventSource?
  arrivalDistanceM    Float?
  arrivalAccuracyM    Float?
  departedAt          DateTime?            @db.Timestamptz(3)
  departureSource     StopEventSource?
  departedAtOutcome   Boolean              @default(false) // no usable departure: the result time ended the stop
  /// false = the automatic arrival was first seen when the page came back (resumed), so its time
  /// is only an upper bound: never used for measured times or the on-time KPI.
  arrivalObserved     Boolean              @default(true)
  autoArrivedAt       DateTime?            @db.Timestamptz(3) // an OBSERVED automatic arrival only
  autoDepartedAt      DateTime?            @db.Timestamptz(3) // an OBSERVED automatic departure only
  autoBasis           String? // 'DEPARTURE' | 'RESULT': what ended the automatic timing
  autoMinutes         Float? // observed auto arrival -> observed departure, else -> the driver's result time
  autoServiceMinutes  Float? // the same, from max(arrival, window start), break excluded
  /// Plausibility flags of the phone-reported positions: any flag excludes the visit from
  /// measured times, the on-time KPI and the pin check. The overlay says "unverified timing".
  timingSuspect       Boolean              @default(false)
  // Result (rebuilt from the latest OUTCOME event):
  outcome             DeliveryOutcome?
  reason              NotDeliveredReason?
  reasonNote          String?
  outcomeAt           DateTime?            @db.Timestamptz(3)
  outcomeSource       StopEventSource?
  outcomeById         String?
  outcomeBy           User?                @relation("StopVisitOutcomeBy", fields: [outcomeById], references: [id], onDelete: SetNull)
  outcomeLat          Float?
  outcomeLng          Float?
  outcomeAccuracyM    Float?
  outcomeDistanceM    Float?
  /// The current result came from an event received after the load was COMPLETED or after the
  /// link expired: shown "recorded after the trip closed", never ticked in Bring forward.
  outcomeLate         Boolean              @default(false)
  noPhotoReason       String? // 'CAMERA_FAILED' (the driver's only exception to "photo required")
  photoKeysJson       Json? // photo keys the result named (shows "photo not received yet")
  photoCount          Int                  @default(0)
  // The driver's own last Delivered or Partly result (owner decision 2 of 5 Oct 2026), rebuilt from the
  // events the driver link sent. A result the office records (Record) never changes these four, so a
  // result the driver saved without a photo stays on the lists, the KPI and the Excel after a correction
  // (lib/delivery/camera-exceptions.ts).
  driverResultAt      DateTime?            @db.Timestamptz(3)
  driverResultOutcome DeliveryOutcome?
  driverNoPhotoReason String? // 'CAMERA_FAILED': that result was saved with "Camera not working"
  driverPhotoKeys     Int                  @default(0) // photo keys named by the driver's Delivered / Partly results
  locationPurgedAt    DateTime?            @db.Timestamptz(3) // lat/lng/accuracy erased; distances kept
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  events              StopEvent[]
  photos              DeliveryPhoto[]

  @@unique([tenantId, depotId, deliveryDate, truckId, loadNo, sequence])
  @@index([tenantId, deliveryDate])
  @@index([tenantId, customerId, deliveryDate])
}

/// Append-only log: what happened at a stop, from which source. Ayun (later) writes here too.
model StopEvent {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId         String
  deliveryDate    DateTime        @db.Date
  truckId         String
  loadNo          Int
  sequence        Int? // NULL = load level (BACK_AT_DEPOT)
  visitId         String?
  visit           StopVisit?      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind            StopEventKind
  source          StopEventSource
  at              DateTime        @db.Timestamptz(3) // when it happened (device clock, corrected and clamped)
  receivedAt      DateTime        @default(now()) @db.Timestamptz(3)
  lat             Float?
  lng             Float?
  accuracyM       Float?
  distanceM       Float? // from the stop's planned pin (the depot pin for BACK_AT_DEPOT)
  speedMps        Float?
  driverLinkId    String?
  driverLink      DriverLink?     @relation(fields: [driverLinkId], references: [id], onDelete: SetNull)
  linkGeneration  Int?
  userId          String?
  user            User?           @relation("StopEventUser", fields: [userId], references: [id], onDelete: SetNull)
  clientIp        String? // as AuditLog: who sent it (erased with the location)
  deviceId        String? // sha256 of the page's random per-browser id, first 16 hex (erased with the location)
  /// Namespaced on the server so sources cannot collide: "dl:<uuid>" (driver action),
  /// "dlphoto:<uuid>" (driver photo), "disp:<uuid>" (dispatcher), "ayun:<id>" (later).
  idempotencyKey  String
  payloadJson     Json? // also: late, clockSkewMs, gpsAt, suspect[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, deliveryDate, truckId])
  @@index([visitId, at])
  /// The janitor's returned-loads sweep (kind BACK_AT_DEPOT, newest first).
  @@index([kind, receivedAt])
  /// The location retention sweep (per company, by receipt time).
  @@index([tenantId, receivedAt])
}

/// A delivery photo: compressed JPEG in the database. bytes = NULL once the retention janitor
/// dropped it; the metadata stays.
model DeliveryPhoto {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId          String
  visit            StopVisit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  idempotencyKey   String
  source           StopEventSource
  driverLinkId     String?
  driverLink       DriverLink?         @relation(fields: [driverLinkId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?               @relation("DeliveryPhotoUser", fields: [userId], references: [id], onDelete: SetNull)
  clientIp         String?
  deviceId         String?
  /// The capture time on the device clock, skew-corrected and clamped to
  /// [zonedDayStart(date) - 6 h, receivedAt]. The raw value is in rawTakenAt.
  takenAt          DateTime            @db.Timestamptz(3)
  rawTakenAt       DateTime?           @db.Timestamptz(3)
  receivedAt       DateTime            @default(now()) @db.Timestamptz(3) // server time: retention runs on it
  positionStatus   PhotoPositionStatus
  lat              Float?
  lng              Float?
  accuracyM        Float?
  distanceM        Float?
  exifLat          Float?
  exifLng          Float?
  exifTakenAt      DateTime?           @db.Timestamptz(3) // parsed with OffsetTimeOriginal, else the tenant time zone
  exifDistanceM    Float?
  oldPhoto         Boolean             @default(false) // EXIF time or file time > 15 min before the arrival / dispatch
  contentType      String              @default("image/jpeg")
  byteSize         Int // of the stored (metadata-stripped) bytes
  width            Int?
  height           Int?
  sha256           String // of the stored (metadata-stripped) bytes
  bytes            Bytes?
  purgedAt         DateTime?           @db.Timestamptz(3)
  locationPurgedAt DateTime?           @db.Timestamptz(3)

  @@unique([tenantId, idempotencyKey])
  @@index([visitId])
  @@index([tenantId, receivedAt])
  /// The daily photo cap per driver link.
  @@index([driverLinkId])
}
