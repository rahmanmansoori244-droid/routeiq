// RouteIQ v1.3 schema — see CLAUDE.md section 5
// Every business table has tenantId. All reads/writes go through tenantDb() wrapper.

// NOTE: postgis extension declaration is intentionally omitted. Production Railway runs
// postgres-ssl:18 (PostGIS not guaranteed; nothing queries it); the init migration only tries
// CREATE EXTENSION and tolerates its absence (its comment about a PostGIS image is outdated). When developing
// locally with a PostGIS-equipped DB, re-add:
//   extensions = [postgis(map: "postgis")]
// to the datasource and:
//   previewFeatures = ["postgresqlExtensions"]
// to the generator.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // IVMS live link (16 Oct 2026): `omit` hides the IVMS columns of Truck and Depot from every read
  // (lib/db.ts PRISMA_GLOBAL_OMIT), so no existing response, page, export or audit row changes and
  // only the IVMS code, which asks for them by name, ever sees a tracker IMEI. GA in Prisma 6.2.
  previewFeatures = ["omitApi"]
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  PLANNER
  SUPERVISOR
  VIEWER
}

enum CapacityUnit {
  CASES
  CARTONS
  PALLETS
  KG
}

enum OptimizationMode {
  MIN_TRUCKS
  MIN_DISTANCE
  MIN_COST
  BALANCED
  MAX_UTILIZATION
}

enum OrderStatus {
  UPLOADED
  VALIDATED
  ASSIGNED
  DISPATCHED
  DELIVERED
  FAILED
  UNSERVED
}

enum RunStatus {
  DRAFT
  OPTIMIZING
  READY
  FAILED
  DISPATCHED
  ARCHIVED
  // A newer plan version (late order / re-plan) replaced this one. Kept for traceability.
  SUPERSEDED
}

// NMWC dispatch MVP ----------------------------------------------------------------------
// One physical load of one truck. Lifecycle: PLANNED -> LOCKED -> LOADING -> DISPATCHED ->
// COMPLETED. PLANNED loads may be re-optimized; LOCKED/LOADING loads are kept verbatim by a
// re-plan unless explicitly unlocked; DISPATCHED/COMPLETED loads are immutable.
enum LoadStatus {
  PLANNED
  LOCKED
  LOADING
  DISPATCHED
  COMPLETED
}

enum PlanReason {
  INITIAL
  LATE_ORDER
  MANUAL_ADJUSTMENT
  REOPTIMIZE
}

enum CustomerType {
  HYPERMARKET
  SUPERMARKET
  TRADING
  CATERING
  HORECA
  GROCERY
  WHOLESALE
  OTHER
}

enum LocationSource {
  IMPORT
  MANUAL_LATLNG
  GOOGLE_MAPS_URL
  MAP_PIN
  GEOCODER
  CRM
}

enum PaymentType {
  CASH
  CREDIT
  PREPAID
}

enum UploadBatchStatus {
  PARSED
  VALIDATED
  CONFIRMED
  REJECTED
  DELETED
}

enum RunJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum UnservedReasonCode {
  MISSING_COORDINATES
  EXCEEDS_TRUCK_CAPACITY
  NO_AVAILABLE_TRUCK
  SHIFT_TIME_LIMIT
  INVALID_CUSTOMER
  SOLVER_DROPPED_LOW_PRIORITY
  INFEASIBLE_ROUTE
  UNKNOWN
  // dispatch MVP
  INVALID_LOCATION
  UNKNOWN_CUSTOMER
  UNKNOWN_PRODUCT
  EXCEEDS_ANY_TRUCK_CAPACITY
  HARD_WINDOW_INFEASIBLE
  SHIFT_LIMIT
  TRIP_LIMIT
  LOCKED_PLAN_CONFLICT
  LATE_ORDER_NO_CAPACITY
  ROUTING_PROVIDER_FAILURE
  INFEASIBLE
  // Owner request 13 Oct 2026: a "small truck only" order no small truck could take (the optimizer's
  // NO_ALLOWED_TRUCK: none today, none big enough, or none with room or time).
  NO_ALLOWED_TRUCK
  // Moves by hand (owner decision 24 Oct 2026): the dispatcher took the stop off the plan (Move, "Take off
  // the plan"); a RE-PLAN plans it again, "Put on a truck" puts it back on a load.
  REMOVED_BY_HAND
}

enum DistanceProvider {
  HAVERSINE
  MAPBOX_MATRIX
  OSRM
}

model Tenant {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  country     String
  currency    String        @default("OMR")
  primaryUnit CapacityUnit  @default(CASES)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  config      TenantConfig?

  users                User[]
  depots               Depot[]
  trucks               Truck[]
  drivers              Driver[]
  regions              Region[]
  customers            Customer[]
  products             Product[]
  uploadBatches        UploadBatch[]
  orders               Order[]
  runs                 RunPlan[]
  runJobs              RunJob[]
  manualBaselines      ManualBaseline[]
  audits               AuditLog[]
  passwordResets       PasswordResetToken[]
  driverShifts         DriverShift[]
  truckLocations       TruckLocation[]
  deliveryProofs       DeliveryProof[]
  customerTypeProfiles CustomerTypeProfile[]
  planLoads            PlanLoad[]
  intakeLineKeys       IntakeLineKey[]
  driverLinks          DriverLink[]
  salesLinks           SalesLink[]
  stopVisits           StopVisit[]
  stopEvents           StopEvent[]
  deliveryPhotos       DeliveryPhoto[]
  hireOptions          HireOption[]
  hireSuggestions      HireSuggestion[]
  driverLeaves         DriverLeave[]
  // Helpers (truck crew), owner request 13 Oct 2026.
  helpers              Helper[]
  planLoadHelpers      PlanLoadHelper[]
  // Operations alerts, owner request 16 Oct 2026.
  opsAlerts            OpsAlert[]
  opsAlertDigests      OpsAlertDigest[]
  // IVMS live link (Ayun GPS trackers), 16 Oct 2026: lib/ivms/*.
  truckPositions       TruckPosition[]
  truckTrailPoints     TruckTrailPoint[]
  ivmsEvents           IvmsEvent[]
  ivmsState            IvmsState?
  ivmsTruckDays        IvmsTruckDay[]
  // The analysis dataset (owner request 19 Oct 2026): lib/analysis/*.
  factTruckDays        FactTruckDay[]
  factVisits           FactVisit[]
  factLegs             FactLeg[]
  factDepotTurns       FactDepotTurn[]
}

model TenantConfig {
  id                          String           @id @default(cuid())
  tenantId                    String           @unique
  tenant                      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avgSpeedKmh                 Float            @default(40)
  distanceProvider            DistanceProvider @default(OSRM)
  distanceMultiplier          Float            @default(1.30)
  // TODO v2: replace single tenant-wide multiplier with per-region overrides (RegionDistanceConfig).
  // City centers (Muscat) typically need ~1.4-1.5, highway regions (Duqm) ~1.1-1.2.
  // v2 should auto-calibrate from ManualBaseline.manual_distance_km vs Haversine-estimated distance.
  /// @deprecated Not read by the dispatch planner (estimated distances are always labelled). Hidden
  /// from Settings since stabilization PR5; dropped in a later expand-then-contract release.
  labelEstimatedDistances     Boolean          @default(true)
  driverShiftMaxMinutes       Int              @default(540)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  returnToDepot               Boolean          @default(true)
  defaultServiceTimeMin       Int              @default(10)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  costPerKmDefault            Float            @default(0.15)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  fixedTruckCostPerDayDefault Float            @default(20)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  latePenaltyPerMin           Float            @default(0.5)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  underutilizationPenalty     Float            @default(0)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  solverTimeLimitSeconds      Int              @default(30)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveTrucks       Float            @default(1000)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveDistance     Float            @default(1)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveCost         Float            @default(0)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveBalance      Float            @default(0)
  /// @deprecated Not read by the dispatch planner; hidden from Settings (stabilization PR5).
  weightObjectiveUtilization  Float            @default(0)

  // --- NMWC dispatch MVP (all times are minutes from local midnight) ---
  timezone                String  @default("Asia/Muscat")
  planningCutoffMin       Int     @default(1080) // orders after 18:00 the day before = LATE
  shiftStartMin           Int     @default(360) // earliest first departure 06:00
  reloadMinutes           Int     @default(30) // depot turnaround between loads
  loadingMinPerCase       Float   @default(0) // + loading time per case of the next load (0.04 -> 1,100 cases = 44 min)
  serviceMinPerCase       Float   @default(0) // + unloading time per case at the customer, on top of its service time
  maxTripsPerTruck        Int     @default(3)
  fuelPricePerLitre       Float   @default(0) // OMR; 0 = fuel not costed separately
  driverCostPerHour       Float   @default(0)
  overtimeAfterMin        Int     @default(540)
  // Driver break (owner rule 29-30 Sep 2026): one break per truck-day that works through midday,
  // STARTING between driverBreakFromMin and driverBreakToMin (minutes from midnight), on the road
  // between stops or at the depot (it may overlap reloading), never while unloading; inside the
  // shift, paid. 0 = no break (the default: the dispatcher turns it on in Settings after deploy).
  driverBreakMinutes      Int     @default(0)
  driverBreakFromMin      Int     @default(720)
  driverBreakToMin        Int     @default(840)
  overtimeCostPerHour     Float   @default(0)
  // Owner answer 4 (6 Oct 2026): the casual driver of a truck hired for the day (the hire suggestion) is
  // paid this per day (OMR), fixed, instead of driverCostPerHour and overtime; own trucks keep theirs. A
  // rough 10 OMR until the owner sets it (company admin, Settings). 0-1000 (database CHECK).
  dailyDriverDayRate      Float   @default(10)
  prefWindowPenaltyPerMin Float   @default(0.05)
  roadTimeFactor          Float   @default(1.25) // trucks vs cars on OSRM durations
  splitDeliveries         Boolean @default(true) // customers bigger than the largest truck are delivered in parts
  // Pallet fill (owner decision 4 Oct 2026): the percent of a truck's bays the planner may fill with
  // mixed pallets. 100 = every bay (the default, owner decision); lower = a safety margin (12 bays at
  // 95% = 11.4 pallets). 50-100 (database CHECK).
  palletFillPct           Int     @default(100)
  // Owner decision 13 Oct 2026 ("small truck only" customers): a truck with at most this many bays is a
  // small truck; a customer marked smallTruckOnly is planned on such trucks only (own and hired for the
  // day, and the trucks the hire check may rent). A truck without bays is never small. 1-40 (database
  // CHECK, the trucks' bays range); 6 by default (NMWC: 3-ton trucks 4-6 bays, 10-ton 11-12).
  smallTruckMaxBays       Int     @default(6)
  // Receiving hours (owner request 13 Oct 2026, "14:00 IS the latest arrival"): what the END of a customer's
  // receiving hours means. 'FINISH' (the default, owner rule 29 Sep 2026) = unloading finished by then;
  // 'START' = the latest arrival (unloading starts by then and may continue after it). Sent to the optimizer
  // as config.window_rule; each load keeps the rule the optimizer echoed (PlanRules.windowRule). Company
  // admin. 'START' | 'FINISH' (database CHECK; lib/dispatch/window-rule.ts).
  windowRule              String  @default("FINISH")
  osrmUrl                 String? // overrides the OSRM_URL env var; there is no silent public default
  priorityWeightsJson     Json? // {"1":10000,...,"5":1}; must be strictly decreasing
  orderColumnMapJson      Json? // extra header aliases for the NMWC order export
  dateOrder               String  @default("DMY") // how to read 03/04/2026
  serviceAreaJson         Json? // {"minLat":..,"maxLat":..,"minLng":..,"maxLng":..} location sanity box
  // Owner decisions 1 Oct 2026 (data collection, items 3 and 4). Loading gate: when on, a load is
  // locked, loaded or dispatched only when every customer on it has a usable location and a delivery
  // window (its own confirmed hours, or a delivery time on the order). Off by default: the dispatcher
  // or admin switches it on at launch. Planning is never refused by it.
  requireDataBeforeLoading Boolean @default(false)
  // Data to collect: customers with open orders from today to this many days ahead that miss a
  // location or their own confirmed receiving hours.
  dataCollectDays          Int     @default(3)
  // Delivery outcome and the driver page (owner request 4 Oct 2026). Admin settings.
  // Radius around a stop's pin inside which the driver page counts the truck as arrived (50-500 m).
  geofenceRadiusM          Int      @default(100)
  // Delivered and Partly delivered need a photo from the driver (one exception: "Camera not working").
  photoProofRequired       Boolean  @default(true)
  // Delivery photo bytes are dropped after this many days (the metadata stays), 30-1095. Owner
  // decision 1 (5 Oct 2026): 90 days (it was 365; migration 20261005090000 moved companies on 365).
  photoRetentionDays       Int      @default(90)
  // Positions, IP addresses and browser ids of driver events and photos are erased after this many
  // days (30 .. photoRetentionDays); the distances from the pin are kept.
  locationRetentionDays    Int      @default(90)
  // The company number behind the driver page's "Call dispatcher" button: used when the truck's depot
  // has no number of its own (Depot.dispatcherPhone, owner decision 3 of 5 Oct 2026); hidden while
  // neither has one.
  dispatcherPhone          String?
  // Deliveries before this moment are outside the no-result list and the outcome KPIs (set to the
  // migration time for existing companies).
  outcomesSince            DateTime @default(now())
  // Operations alerts (owner request 16 Oct 2026: "notify me when a rule I set is broken"). Company admin
  // only; lib/alerts/catalog.ts holds the rules, their defaults and bounds (database CHECKs in migration
  // 20261016180000_ops_alerts). The master switch is OFF by default: merging and deploying change nothing
  // until a company admin switches it on. A NULL threshold turns that rule off.
  alertsEnabled            Boolean  @default(false)
  // Set by the settings save that switches alerts on (app/api/tenant/config): nothing that began or
  // happened before it raises an alert (no backlog on switch-on). Not a Settings field.
  alertsEnabledAt          DateTime?
  // Per rule, when it was last switched on or set to catch more (a lower limit; for R7 a higher priority
  // number): { "PROOF_FAR": ISO time }, set by the same save. A rule switched on after the master switch
  // raises nothing that began before its own switch-on either (review of 16 Oct 2026). Not a Settings field.
  alertRuleOnAtJson        Json?
  // R1 unloading longer than planned by more than N min (owner rule 1: 30).
  alertUnloadOverMin       Int?     @default(30)
  // R2 loading between trips longer than N min (owner rule 2: 40). Owner decision 16 Oct 2026: measured
  // from the driver's Back at depot to his "Leaving for next load" (StopEvent DEPOT_DEPART; the Dispatch
  // press or the first arrival when he did not tap), never for the first trip of the day (loaded the night
  // before), so it is on (40) like the other rules, under the master switch (off).
  alertLoadingOverMin      Int?     @default(40)
  // R3 the projected arrival at the next stop is more than N min late (owner rule 3: 30).
  alertEtaLateMin          Int?     @default(30)
  // R4 a Locked or Loading load still not dispatched N min after its planned departure (today only).
  alertDepartLateMin       Int?     @default(30)
  // R5 nothing from the driver's phone for N min while stops are left.
  alertSilentMin           Int?     @default(120)
  // R11 dispatched, but the driver page was never opened N min after the planned departure.
  alertPageNotOpenedMin    Int?     @default(30)
  // R6 a stop reached (or projected) more than N min after its delivery window ends.
  alertAfterClosingMin     Int?     @default(15)
  // R7 a stop of priority N or better (1 = highest) not delivered or partly delivered.
  alertPriorityMax         Int?     @default(2)
  // R8 a stop marked Delivered by the driver with a note.
  alertDeliveredNote       Boolean  @default(true)
  // R9 a delivery photo or result more than N metres from a verified customer pin.
  alertProofFarM           Int?     @default(500)
  // R10 a dispatched load still not closed N min after its planned return.
  alertNotClosedMin        Int?     @default(120)
  // E-mail: at most 5 comma-separated addresses (NULL = in the app only); at most one e-mail every N min
  // (0 = never); only alerts of this severity or above (HIGH by default); no e-mail in the quiet hours
  // (from-to, minutes from local midnight, may pass midnight; both NULL = none). In the app always.
  alertEmails              String?
  alertEmailEveryMin       Int      @default(15)
  alertEmailMinSeverity    String   @default("HIGH")
  alertQuietFromMin        Int?     @default(1320)
  alertQuietToMin          Int?     @default(360)
  // IVMS live link (Ayun GPS trackers, 16 Oct 2026; lib/ivms/settings.ts IVMS_SETTING_BOUNDS, database
  // CHECKs in 20261016200000_ivms_live). Company admin only. Nothing here is read while ivmsMode is OFF.
  // OFF (default: no call to Ayun, nothing new shown) | MAP (live truck positions on the day screen) |
  // TIMES (MAP + arrival and departure times from the trackers' history) | ALERTS (TIMES + the operations
  // alerts read the GPS times, the depot moves and the fresh live position: owner request 18 Oct 2026,
  // CHECK from 20261018120000_ivms_alerts_mode).
  ivmsMode                 String   @default("OFF")
  // Seconds between two live-position calls while a mapped truck has a load out (30-900); the daily
  // allowance may stretch it (lib/ivms/budget.ts). Positions are for the map only, never for times.
  ivmsPollSec              Int      @default(60)
  // Minutes between two history pulls of one truck while its load is out (30-240), plus one pull at
  // the end: the source of GPS arrival and departure times (TIMES).
  ivmsRoutePullMin         Int      @default(60)
  // Operating hours, minutes from local midnight: no call outside [ivmsFromMin, ivmsToMin) unless a
  // load is still out. 05:00-23:00 by default; ivmsToMin > ivmsFromMin (no hours across midnight).
  ivmsFromMin              Int      @default(300)
  ivmsToMin                Int      @default(1380)
  // The provider's daily call allowance (today 100): RouteIQ never makes more calls than this per UTC
  // day, all classes together (10-100000).
  ivmsDailyCallBudget      Int      @default(100)
  // GPS stop detection: a truck is at a customer when it stays within this distance of the pin
  // (50-300 m; the same 100 m as the phone's geofenceRadiusM by default) for at least ivmsStopDwellMin
  // minutes (1-30); the depot counts within ivmsDepotRadiusM (100-2000 m).
  ivmsStopRadiusM          Int      @default(100)
  ivmsStopDwellMin         Int      @default(3)
  ivmsDepotRadiusM         Int      @default(300)
  // Days the trucks' GPS trail is kept (1-7): written only while a load is out, never exported.
  ivmsTrailDays            Int      @default(2)
  // The analysis dataset (owner request 19 Oct 2026, "build on more data for our analysis later and
  // improvement"; lib/analysis/*): the per-visit, per-leg, per-depot-turn and per-truck-day facts are kept
  // this many days after their delivery date (30-3650, database CHECK in 20261019090000_analysis_facts), then
  // deleted by lib/ivms/retention.ts purgeAnalysisFacts. Company admin. No raw position is ever kept in them.
  analysisRetentionDays    Int      @default(730)
}

// Defaults per customer type; a customer's own values always win.
model CustomerTypeProfile {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerType       CustomerType
  defaultPriority    Int?
  serviceTimeMin     Int?
  hardWindowStartMin Int?
  hardWindowEndMin   Int?
  prefWindowStartMin Int?
  prefWindowEndMin   Int?

  @@unique([tenantId, customerType])
}

model User {
  id                   String               @id @default(cuid())
  tenantId             String?
  tenant               Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                String               @unique
  passwordHash         String
  name                 String
  role                 Role                 @default(VIEWER)
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  uploadBatches        UploadBatch[]
  runJobs              RunJob[]
  manualBaselines      ManualBaseline[]
  audits               AuditLog[]
  routeAssignmentLocks RouteAssignment[]    @relation("RouteAssignmentLockedBy")
  passwordResets       PasswordResetToken[]
  verifiedLocations    Customer[]           @relation("CustomerLocationVerifiedBy")
  lateOrders           Order[]              @relation("OrderLateRecordedBy")
  loadStatusChanges    PlanLoad[]           @relation("PlanLoadStatusBy")
  loadDriversSet       PlanLoad[]           @relation("PlanLoadDriverSetBy")
  ordersCarried        Order[]              @relation("OrderCarriedBy")
  confirmedWindows     Customer[]           @relation("CustomerWindowConfirmedBy")
  orderTimesSet        Order[]              @relation("OrderDeliveryTimeSetBy")
  ordersCancelled      Order[]              @relation("OrderCancelledBy")
  driverLinksIssued    DriverLink[]         @relation("DriverLinkIssuedBy")
  driverLinksRevoked   DriverLink[]         @relation("DriverLinkRevokedBy")
  salesLinksIssued     SalesLink[]          @relation("SalesLinkIssuedBy")
  salesLinksRevoked    SalesLink[]          @relation("SalesLinkRevokedBy")
  stopOutcomesSet      StopVisit[]          @relation("StopVisitOutcomeBy")
  stopEvents           StopEvent[]          @relation("StopEventUser")
  deliveryPhotos       DeliveryPhoto[]      @relation("DeliveryPhotoUser")
  driverLeavesAdded    DriverLeave[]        @relation("DriverLeaveCreatedBy")
  driverLeavesChanged  DriverLeave[]        @relation("DriverLeaveUpdatedBy")
  loadHelpersSet       PlanLoad[]           @relation("PlanLoadHelpersSetBy")
  opsAlertsAcked       OpsAlert[]           @relation("OpsAlertAckedBy")
  opsAlertsReviewed    OpsAlert[]           @relation("OpsAlertReviewedBy")
  opsAlertsFirstReviewed OpsAlert[]         @relation("OpsAlertFirstReviewedBy")

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Depot {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  lat           Float
  lng           Float
  address       String?
  active        Boolean       @default(true)
  openMin       Int? // depot opening, minutes from midnight; null = 00:00
  closeMin      Int? // depot closing; null = 24:00
  /// Audit PR A5: a depot that only keeps the orders and order files that had no depot before the
  /// owner rule "every order has a depot" (migration 20260930120000_orders_always_have_depot, code
  /// NO-DEPOT). Always inactive: never offered in a picker, never planned, and the app refuses to
  /// make it active or to put a truck or region on it. The database refuses it too (CHECK
  /// "Depot_historyOnly_not_active", in that migration; Prisma's schema has no CHECK constraints).
  historyOnly   Boolean       @default(false)
  /// Owner decision 3 (5 Oct 2026): the number behind the driver page's "Call dispatcher" for the
  /// trucks of this depot (company admin, Depots page). Null: the company number
  /// (TenantConfig.dispatcherPhone). lib/driver-link/dispatcher-phone.ts.
  dispatcherPhone String?
  /// IVMS live link (16 Oct 2026): the name of the Ayun zone whose IN/OUT events are this depot's
  /// (compared trimmed and case-insensitively, 1-80 characters). NULL = the depot pin and
  /// TenantConfig.ivmsDepotRadiusM only. Company admin; hidden from every read like Truck.ivmsImei.
  ivmsZoneName  String?
  trucks        Truck[]
  regions       Region[]
  runs          RunPlan[]
  orders        Order[]
  uploadBatches UploadBatch[]
  hireOptions   HireOption[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Truck {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId          String
  depot            Depot             @relation(fields: [depotId], references: [id])
  code             String
  description      String?
  capacityCases    Int               @default(0)
  capacityWeightKg Float             @default(0)
  capacityVolumeL  Float             @default(0)
  fixedCostPerDay  Float             @default(0) // fixed operating cost per day the truck is used
  costPerKm        Float             @default(0) // variable cost/km EXCLUDING fuel when kmPerLitre is set
  kmPerLitre       Float? // fuel economy: fuel cost = km / kmPerLitre x fuel price
  /// Bays (pallet positions, owner decision 4 Oct 2026): set = the truck is planned by PALLETS
  /// (bays x TenantConfig.palletFillPct and the payload; capacityCases is then not a limit);
  /// null = planned by cases (capacityCases). The column kept its first name.
  bays             Int?              @map("palletCapacity")
  tripCost         Float             @default(0) // per load (loading labour etc.)
  maxTripsPerDay   Int? // overrides TenantConfig.maxTripsPerTruck
  availableFromMin Int?
  availableToMin   Int?
  defaultDriverId  String?
  /// NO ACTION (audit F20): a driver still set as a truck's default is never deleted (drivers are deactivated).
  defaultDriver    Driver?           @relation("TruckDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: NoAction)
  /// The helper who usually goes out on this truck (owner request 13 Oct 2026): new loads get him, as
  /// they get the default driver. NO ACTION like the default driver: helpers are deactivated, never deleted.
  defaultHelperId  String?
  defaultHelper    Helper?           @relation("TruckDefaultHelper", fields: [defaultHelperId], references: [id], onDelete: NoAction)
  active           Boolean           @default(true)
  /// Hired from outside (owner request 4 Oct 2026): a badge on the plan, the driver sheets and the
  /// driver page. The planner never reads it.
  hired            Boolean           @default(false)
  /// A one-day truck (owner request 6 Oct 2026, the hire suggestion's "Use this plan"): available on
  /// this delivery date only - every plan of another day leaves it out, and the janitor retires it
  /// (active false) once the day is over. Null: an ordinary truck, every day.
  onlyOnDate       DateTime?         @db.Date
  /// The hire option a one-day truck was rented from (its max per day counts it).
  hireOptionId     String?
  hireOption       HireOption?       @relation(fields: [hireOptionId], references: [id], onDelete: SetNull)
  routes           RouteAssignment[]
  shifts           DriverShift[]
  locations        TruckLocation[]
  loads            PlanLoad[]
  driverLinks      DriverLink[]
  stopVisits       StopVisit[]
  /// IVMS live link (16 Oct 2026): the IMEI of the truck's GPS tracker (Ayun), digits only (10-20,
  /// database CHECK). NULL = no tracker: the driver's phone only, exactly as before. Unique per company.
  /// Never on a one-day hired truck (CHECK). Company admin only: lib/db.ts omits it from every read, so
  /// no existing response, page, sheet, export or audit row carries it; the IVMS code selects it by name.
  ivmsImei         String?
  ivmsPosition     TruckPosition?
  ivmsTrail        TruckTrailPoint[]
  ivmsEvents       IvmsEvent[]
  ivmsDays         IvmsTruckDay[]

  @@unique([tenantId, code])
  @@unique([tenantId, ivmsImei])
  @@index([tenantId, depotId])
  @@index([tenantId, onlyOnDate])
}

/// A truck the company can rent for a day (owner request 6 Oct 2026, the hire suggestion): company
/// admin, Trucks page, per depot. When a plan leaves orders out because the fleet cannot carry them,
/// a what-if optimization adds one truck per unit (maxPerDay) and says which ones to rent
/// (lib/dispatch/hire.ts). Nothing is seeded: the admin enters the company's own figures.
model HireOption {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId       String
  depot         Depot    @relation(fields: [depotId], references: [id])
  /// "10-ton", "3-ton": the dispatcher reads it in the suggestion and the truck codes (HIRE-10T-...).
  label         String
  /// Pallet positions (planned by pallets, like a truck with bays); null = planned by capacityCases.
  bays          Int?
  capacityCases Int      @default(0)
  /// Payload in kg; 0 = no weight limit.
  payloadKg     Float    @default(0)
  /// The hire for one day (OMR): the rented truck's fixed cost per day.
  costPerDay    Float
  /// The rental's own charge per km (OMR), if it has one; null = none (0). Fuel is in the hire (owner
  /// answer 3, 6 Oct 2026): a rented truck never costs fuel or the fleet's km rate.
  costPerKm     Float?
  /// How many of this truck the company can rent on one day (1-10).
  maxPerDay     Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trucks        Truck[]

  @@unique([tenantId, depotId, label])
  @@index([tenantId, depotId])
}

/// One what-if optimization of the hire suggestion (owner request 6 Oct 2026): the plan version it
/// was computed for, its own job state (never the plan's RunJob: it never delays or changes the
/// dispatcher's plan), the request and the answer, and the suggestion the dispatcher reads
/// (summaryJson, lib/dispatch/hire.ts). usedAt / usedRunId: "Use this plan" made that version.
model HireSuggestion {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId        String
  run          RunPlan      @relation(fields: [runId], references: [id], onDelete: Cascade)
  status       RunJobStatus @default(QUEUED)
  /// AFTER_PLAN (started by a plan that left orders out) or ASKED ("Check hire options").
  trigger      String
  message      String?
  /// What the plan in use left out, the request's fingerprint and the hire options as they were.
  basisJson    Json
  requestJson  Json?
  responseJson Json?
  summaryJson  Json?
  errorJson    Json?
  createdById  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?    @db.Timestamptz(3)
  finishedAt   DateTime?    @db.Timestamptz(3)
  heartbeatAt  DateTime?    @db.Timestamptz(3)
  usedAt       DateTime?    @db.Timestamptz(3)
  usedById     String?
  usedRunId    String?

  @@index([tenantId, runId])
  @@index([tenantId, status])
}

model Driver {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  phone         String?
  // Module C: drivers sign into the PWA with tenant slug + driver code + 6-char PIN.
  // PIN is stored hashed (bcrypt cost 12, same as User passwords). Null until set.
  accessPinHash String?
  active        Boolean @default(true)
  /// A daily (casual) driver added from a load by the dispatcher (owner request 4 Oct 2026). No
  /// account; an admin may clear it to make them a regular driver.
  casual        Boolean @default(false)

  shifts        DriverShift[]
  defaultTrucks Truck[]       @relation("TruckDefaultDriver")
  loads         PlanLoad[]
  leaves        DriverLeave[] @relation("DriverLeaveOf")
  covers        DriverLeave[] @relation("DriverLeaveCover")

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// A helper (truck crew), owner request 13 Oct 2026: "management asked to track helpers in each truck,
/// so add that like drivers too. We need to know who were the helpers in each truck and load." NMWC
/// trucks go out with a driver plus a helper. Kept like a driver: code (unique per company), name,
/// optional phone, active; never deleted (deactivated), so every load keeps who went on it. The
/// planner never reads helpers: they change who is on a load, not the plan.
model Helper {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  phone         String?
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  defaultTrucks Truck[]          @relation("TruckDefaultHelper")
  loads         PlanLoadHelper[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// The helpers on one load (0 to 3), in the order shown (position 1-3). Copied with the load into
/// every new plan version, like the driver (lib/dispatch/load-helpers.ts).
model PlanLoadHelper {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loadId    String
  load      PlanLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  helperId  String
  /// NO ACTION, as a driver on a load: a helper on a load is never deleted (helpers are deactivated).
  helper    Helper   @relation(fields: [helperId], references: [id], onDelete: NoAction)
  position  Int
  createdAt DateTime @default(now())

  @@unique([loadId, helperId])
  /// One helper per place: with the CHECK (position 1-3) of the migration, at most 3 helpers on a load.
  @@unique([loadId, position])
  @@index([tenantId, helperId])
}

/// A driver's leave (owner request 6 Oct 2026: the dispatcher follows who is away). From and until
/// are delivery dates, both included. On those days RouteIQ never puts the driver on a load; a truck
/// whose usual (default) driver is away gets the cover driver when he is free that day (planDrivers,
/// lib/dispatch/driver-leave.ts). One driver's periods never overlap (checked under the driver's row
/// lock); a period that has started keeps its first day, and one that has ended is kept for the record.
model DriverLeave {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId      String
  /// NO ACTION, as every other reference to a driver (migration 20260930093000_master_data_no_orphans):
  /// a driver is only ever deleted by Start fresh, which keeps a daily driver named by any leave
  /// period (his own or as the cover), so leave and its record never change silently.
  driver        Driver   @relation("DriverLeaveOf", fields: [driverId], references: [id], onDelete: NoAction)
  fromDate      DateTime @db.Date
  untilDate     DateTime @db.Date
  note          String?
  coverDriverId String?
  /// NO ACTION too (see driverId).
  coverDriver   Driver?  @relation("DriverLeaveCover", fields: [coverDriverId], references: [id], onDelete: NoAction)
  createdById   String?
  createdBy     User?    @relation("DriverLeaveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedById   String?
  updatedBy     User?    @relation("DriverLeaveUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt

  @@index([tenantId, untilDate])
  @@index([driverId, fromDate])
}

// Module C — driver tracking.
//
// A DriverShift is one driver's work session on one truck for one RunPlan. It
// scopes GPS pings, deliveries, and proof-of-delivery records. Status moves
// ACTIVE → COMPLETED on shift end (or ABANDONED if the janitor closes a stale one).
enum DriverShiftStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model DriverShift {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId     String
  driver       Driver            @relation(fields: [driverId], references: [id])
  truckId      String
  truck        Truck             @relation(fields: [truckId], references: [id])
  runId        String?
  run          RunPlan?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  // Opaque token the driver PWA holds; required on every GPS-ping call.
  sessionToken String            @unique
  status       DriverShiftStatus @default(ACTIVE)
  startedAt    DateTime          @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?         @db.Timestamptz(3)
  notes        String?
  locations    TruckLocation[]
  proofs       DeliveryProof[]

  @@index([tenantId, status])
  @@index([truckId, status])
  @@index([driverId, status])
  @@index([runId])
}

// One GPS sample. Pings flow ~every 30s from the PWA. We persist all of them so
// the dispatcher view can replay actuals vs planned, and so route-deviation
// analytics works retroactively. A daily janitor archives rows older than 30 days.
model TruckLocation {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck       @relation(fields: [truckId], references: [id])
  ts         DateTime    @db.Timestamptz(3)
  lat        Float
  lng        Float
  speedKmh   Float?
  headingDeg Float?
  accuracyM  Float?
  batteryPct Int?

  @@index([tenantId, truckId, ts])
  @@index([shiftId, ts])
}

// Per-stop completion record. POD = proof of delivery. v1 stores notes + a
// signature blob (base64 PNG, max ~50 KB). Photo upload is deferred to v2 when
// an object store (R2) is wired.
model DeliveryProof {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId         String
  shift           DriverShift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignmentId    String          @unique
  assignment      RouteAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  completedAt     DateTime        @default(now()) @db.Timestamptz(3)
  notes           String?
  signaturePngB64 String?
  lat             Float?
  lng             Float?

  @@index([tenantId, completedAt])
  @@index([shiftId])
}

model Region {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId   String?
  depot     Depot?     @relation(fields: [depotId], references: [id])
  code      String
  name      String
  customers Customer[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Customer {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regionId          String?
  region            Region?     @relation(fields: [regionId], references: [id])
  code              String
  name              String
  branchCode        String?
  branchKey         String      @default("__MAIN__")
  address           String?
  lat               Float?
  lng               Float?
  geocodeConfidence String?
  priority          Int         @default(3) // 1 = HIGHEST ... 5 = LOWEST
  avgServiceTimeMin Int         @default(10)
  paymentType       PaymentType @default(CREDIT)
  accessNotes       String?
  /// Owner request 12 Oct 2026: the customer's phone, for the driver to call before arrival (driver
  /// sheet "Tel ...", the driver page's "Call customer", the data to collect). Optional text as typed,
  /// checked by lib/dispatch/customer-phone.ts (digits, spaces and + - ( ) /, 6 to 20 digits); NULL =
  /// none known. Read live like accessNotes: a correction reaches the sheets and the driver page at once.
  phone             String?
  /// Owner request 13 Oct 2026: the unloading area takes small trucks only (3-ton): planned only on trucks
  /// with at most TenantConfig.smallTruckMaxBays bays (lib/dispatch/small-truck.ts), LOCK / LOADING /
  /// DISPATCH refused on a bigger truck (409 SMALL_TRUCK_ONLY), "SMALL TRUCK ONLY" on the sheets. Read
  /// live: a customer marked after planning is caught by the gate. Audited like the other fields.
  smallTruckOnly    Boolean     @default(false)
  /// Owner request 16 Oct 2026: a short loading instruction the warehouse must follow for this customer's
  /// orders (lib/dispatch/loading-instruction.ts; at most 200 characters on one line, checked by the app).
  /// Printed in a "SPECIAL LOADING" box at the top of every warehouse load sheet, driver sheet and Excel load
  /// sheet whose load has the customer, tagged on its rows, a badge on the plan screen. Read live like
  /// accessNotes (a change reaches sheets already printed when they are printed again; no re-plan). NULL =
  /// none. Audited by the customer UPDATE row. Never sent to the optimizer, never in a plan snapshot.
  loadingInstruction String?
  /// Owner request 19 Oct 2026 ("at big customers the truck moves between drop points and the model thinks
  /// it left"): the customer's GPS site radius in metres, 100-500 (CHECK "Customer_siteRadiusM_range"). The
  /// GPS stop detector (lib/ivms/stops.ts) still needs the truck within the company's stop radius to arrive,
  /// but ends its stay only beyond this radius, and the GPS alerts' "the truck is at the stop" uses it (never
  /// narrower than the company's). NULL (the default) = the company's stop radius: today's behaviour. Edited
  /// in the Details dialog (lib/ivms/site-radius.ts), audited by the customer UPDATE row. Read live.
  siteRadiusM       Int?
  active            Boolean     @default(true)
  orders            Order[]

  // --- NMWC dispatch MVP ---
  customerType         CustomerType?
  priorityConfirmed    Boolean         @default(false) // false = default/type priority; ask the dispatcher
  serviceTimeConfirmed Boolean         @default(false)
  hardWindowStartMin   Int? // delivery outside the hard window is infeasible
  hardWindowEndMin     Int?
  prefWindowStartMin   Int? // outside the preferred window is allowed but penalised
  prefWindowEndMin     Int?
  locationInput        String? // what the dispatcher pasted (link / "lat,lng")
  locationSource       LocationSource?
  locationVerified     Boolean         @default(false)
  locationVerifiedById String?
  locationVerifiedBy   User?           @relation("CustomerLocationVerifiedBy", fields: [locationVerifiedById], references: [id], onDelete: SetNull)
  locationVerifiedAt   DateTime?
  createdFromUpload    Boolean         @default(false) // stub created from an order file
  /// Owner decision 1 Oct 2026 ("own confirmed window"): set when a dispatcher or admin entered or
  /// confirmed this customer's receiving hours (the four window columns; all four empty = open all
  /// day, any time). NULL = not confirmed: the hours in use are a default or were never checked.
  windowConfirmedAt    DateTime?
  windowConfirmedById  String?
  windowConfirmedBy    User?           @relation("CustomerWindowConfirmedBy", fields: [windowConfirmedById], references: [id], onDelete: SetNull)
  /// Owner decision 1 Oct 2026 (item 6, daily customer master): when the customer was created and last
  /// changed. NULL on customers from before this release (nothing recorded when they were made).
  createdAt            DateTime?       @default(now())
  updatedAt            DateTime?       @updatedAt
  stopVisits           StopVisit[]

  @@unique([tenantId, code, branchKey])
  @@index([tenantId, regionId])
  @@index([tenantId, updatedAt])
}

model Product {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  weightPerCaseKg   Float       @default(0) // 0 = unknown
  volumePerCaseL    Float       @default(0)
  unitsPerCase      Int?
  /// The ERP pallet factor (owner decision 4 Oct 2026): cases of this product on one pallet. A
  /// whole number 1-10,000 (lib/dispatch/pallets.ts validPalletFactor; anything else counts as
  /// missing). Needed on every product of a day planned with trucks that have bays.
  casesPerPallet    Float?
  createdFromUpload Boolean     @default(false)
  active            Boolean     @default(true)
  orderLines        OrderLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UploadBatch {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName       String
  fileType       String
  uploadedById   String
  uploadedBy     User              @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime          @default(now())
  deliveryDate   DateTime?         @db.Date
  status         UploadBatchStatus @default(PARSED)
  totalRows      Int               @default(0)
  validRows      Int               @default(0)
  errorRows      Int               @default(0)
  warningRows    Int               @default(0)
  validationJson Json?
  orders         Order[]
  // --- dispatch MVP ---
  /// Required (owner rule, audit PR A5): every order file is for one depot.
  depotId        String
  /// NO ACTION (audit F03): a depot with order files is never deleted (it is deactivated).
  depot          Depot             @relation(fields: [depotId], references: [id], onDelete: NoAction)
  fileHash       String?
  isLate         Boolean           @default(false)
  lateReason     String?

  @@index([tenantId, uploadedAt])
  @@index([tenantId, fileHash])
}

model Order {
  id                        String                     @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer                   @relation(fields: [customerId], references: [id])
  deliveryDate              DateTime                   @db.Date
  totalCases                Int                        @default(0)
  totalWeightKg             Float                      @default(0)
  totalVolumeL              Float                      @default(0)
  totalServiceTimeMin       Int                        @default(10)
  priority                  Int                        @default(3)
  paymentCollectionAmount   Float                      @default(0)
  notes                     String?
  status                    OrderStatus                @default(UPLOADED)
  uploadBatchId             String?
  uploadBatch               UploadBatch?               @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  uploadedAt                DateTime                   @default(now())
  lines                     OrderLine[]
  assignments               RouteAssignment[]
  unservedRecords           UnservedOrder[]
  manualBaselineAssignments ManualBaselineAssignment[]
  // --- dispatch MVP (uploadedAt = received time) ---
  /// Required (owner rule "all orders must have depots linked to them", audit PR A5).
  depotId                   String
  /// NO ACTION (audit F03): a depot with orders is never deleted (it is deactivated), so an order
  /// never loses its depot and never moves into another depot's plan.
  depot                     Depot                      @relation(fields: [depotId], references: [id], onDelete: NoAction)
  isLate                    Boolean                    @default(false)
  lateReason                String?
  lateRecordedById          String?
  lateRecordedBy            User?                      @relation("OrderLateRecordedBy", fields: [lateRecordedById], references: [id], onDelete: SetNull)
  salesValue                Float?
  marginValue               Float?
  priorityFromFile          Boolean                    @default(false) // true = `priority` came from the order file
  // --- Bring forward (PR9): an order not delivered on its own day, carried to a later day ---
  /// On the copy: the order it was brought forward from (one copy per order: unique).
  carriedFromOrderId        String?                    @unique
  carriedFrom               Order?                     @relation("OrderCarriedFrom", fields: [carriedFromOrderId], references: [id], onDelete: NoAction)
  carriedFromCopy           Order?                     @relation("OrderCarriedFrom")
  /// On the copy: the delivery date the order was first due (the first order's date when carried more than once).
  carriedFromDate           DateTime?                  @db.Date
  /// On the original: its copy on the later day. Set = no longer open, unserved or pending on its own day.
  carriedToOrderId          String?                    @unique
  carriedTo                 Order?                     @relation("OrderCarriedTo", fields: [carriedToOrderId], references: [id], onDelete: NoAction)
  carriedToOrigin           Order?                     @relation("OrderCarriedTo")
  carriedAt                 DateTime?
  carriedById               String?
  carriedBy                 User?                      @relation("OrderCarriedBy", fields: [carriedById], references: [id], onDelete: SetNull)
  // --- Delivery time for this one order (owner decision 1 Oct 2026): urgent or promised. It replaces
  // the customer's receiving hours for this order only; the customer master is not changed. Minutes
  // from local midnight; one end may be empty ("by 10:00", "from 14:00"); both empty = none.
  deliveryStartMin          Int?
  deliveryEndMin            Int?
  /// URGENT | PROMISED | OTHER (lib/dispatch/order-window.ts).
  deliveryTimeReason        String?
  deliveryTimeNote          String?
  deliveryTimeSetAt         DateTime?
  deliveryTimeSetById       String?
  deliveryTimeSetBy         User?                      @relation("OrderDeliveryTimeSetBy", fields: [deliveryTimeSetById], references: [id], onDelete: SetNull)
  /// On a brought-forward copy: the delivery results (visits and not-delivered cases per line) the
  /// carry was based on (owner request 4 Oct 2026). Null on copies made from other reasons or before.
  carryBasisJson            Json?
  // --- Cancel order (owner request 12 Oct 2026): a soft cancel of the whole order (every invoice of it).
  // Set = the order is out of planning, the counts, Bring forward and the data to collect; it stays on
  // its day for the record (a "Cancelled" list with Undo). Its status keeps the day's history, and its
  // intake keys stay, so the same invoice re-sent for the same day is skipped (lib/dispatch/order-cancel.ts).
  cancelledAt               DateTime?
  cancelledById             String?
  cancelledBy               User?                      @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  /// CUSTOMER_CANCELLED | WRONG_OR_DUPLICATE | NO_ACCESS_SMALL_TRUCK | OTHER (lib/dispatch/order-cancel.ts).
  cancelReason              String?
  cancelNote                String?

  @@index([tenantId, deliveryDate])
  @@index([tenantId, customerId])
  @@index([tenantId, depotId, deliveryDate])
  // An order file's orders: the file delete, the files list's order counts and the SET NULL key
  // when a file row itself is deleted (review db-schema-1).
  @@index([uploadBatchId])
}

model OrderLine {
  id                 String         @id @default(cuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product        @relation(fields: [productId], references: [id])
  cases              Int
  // --- dispatch MVP: keep sales-order / SKU detail so manifests reconcile exactly ---
  salesOrderNo       String?
  orderDate          DateTime?      @db.Date
  productDescription String?
  weightKg           Float          @default(0) // 0 = unknown
  /// The line's kg is (to be) cases x the product's case weight: the file gave no weight for it.
  /// Such a line follows the product master: a case weight entered or corrected later is applied
  /// at the next optimize / re-plan (unless the line is on a frozen load). File weights are kept.
  weightFromMaster   Boolean        @default(false)
  salesValue         Float?
  marginValue        Float?
  sourceRow          Int?
  notes              String?
  /// The salesman's route that sold this invoice line (owner request 17 Oct 2026, "Salesman ETA"): the
  /// order file's "route" column, trimmed, inner spaces collapsed, upper-case, at most 40 characters
  /// (lib/dispatch/sales-route.ts). Null = the file had no route (or the line was added before it was
  /// kept). A label read by the Salesman ETA export and the salesman link (lib/sales-link/*, owner request
  /// 19 Oct 2026): never part of a duplicate or intake key, never read by planning. Copied with the line
  /// when an order is brought forward or postponed.
  salesRoute         String?
  intakeKey          IntakeLineKey?

  @@index([orderId])
  @@index([salesOrderNo])
}

/// Durable identity of a confirmed sales-order line (delivery date + sales order + customer +
/// product), so the same line can never be confirmed twice: from two files, two tabs or a late
/// order. Lines without a sales-order number have no key (the file hash covers them). The key
/// goes away with its order line, so a permitted batch delete frees it for a re-upload.
model IntakeLineKey {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime  @db.Date
  salesOrderNorm String // sales-order number, trimmed and upper-case
  customerId     String
  productId      String
  orderLineId    String    @unique
  orderLine      OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  uploadBatchId  String? // null = late order recorded on the plan
  createdAt      DateTime  @default(now())

  @@unique([tenantId, deliveryDate, salesOrderNorm, customerId, productId])
  @@index([tenantId, salesOrderNorm])
}

model RunPlan {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId            String
  depot              Depot             @relation(fields: [depotId], references: [id])
  runDate            DateTime          @db.Date
  status             RunStatus         @default(DRAFT)
  optimizationMode   OptimizationMode  @default(BALANCED)
  chosenScenarioId   String?
  totalOrders        Int               @default(0)
  unservedCount      Int               @default(0)
  createdById        String
  createdAt          DateTime          @default(now())
  finalizedAt        DateTime?
  scenarios          ScenarioResult[]
  routes             RouteAssignment[]
  currentJobId       String?
  jobs               RunJob[]
  manualBaselines    ManualBaseline[]
  driverShifts       DriverShift[]
  // --- dispatch MVP: plan versions (a plan is never overwritten invisibly) ---
  version            Int               @default(1)
  parentRunId        String?
  parentRun          RunPlan?          @relation("PlanVersions", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns          RunPlan[]         @relation("PlanVersions")
  reason             PlanReason        @default(INITIAL)
  reasonNote         String?
  supersededAt       DateTime?
  changeSummaryJson  Json?
  reconciliationJson Json?
  summaryJson        Json?
  /// Timetable check of this version's loads per truck-day (lib/dispatch/feasibility.ts): what
  /// LOCK / LOADING / DISPATCH are gated on. Null for versions made before it existed (computed
  /// on the next load change).
  feasibilityJson    Json?
  loads              PlanLoad[]
  hireSuggestions    HireSuggestion[]

  @@index([tenantId, runDate])
  @@index([tenantId, currentJobId])
  @@index([tenantId, depotId, runDate, version])
}

model PlanLoad {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId               String
  run                 RunPlan           @relation(fields: [runId], references: [id], onDelete: Cascade)
  truckId             String
  truck               Truck             @relation(fields: [truckId], references: [id])
  loadNo              Int
  status              LoadStatus        @default(PLANNED)
  driverId            String?
  /// NO ACTION (audit F20): a driver on a load is never deleted (drivers are deactivated), so a
  /// load never loses who drove it.
  driver              Driver?           @relation(fields: [driverId], references: [id], onDelete: NoAction)
  departMin           Int
  returnMin           Int
  distanceKm          Float
  durationMin         Int
  cases               Int
  weightKg            Float
  utilizationPct      Float
  fuelLitres          Float?
  fuelCost            Float             @default(0)
  operatingCost       Float             @default(0)
  returnLegKm         Float             @default(0)
  distanceIsEstimated Boolean           @default(true)
  /// The truck and planning rules this load was timed with (code, capacities, costs, availability,
  /// turnaround / shift / depot hours): lib/dispatch/snapshots.ts. Null on loads planned before
  /// snapshots existed (the live truck is shown, labelled as such).
  truckSnapshotJson   Json?
  // The driver break planned with this load (v1: startMin, endMin, lengthMin, where DEPOT | ROAD,
  // afterSequence), or NULL. Copied with the load into every new version, so a locked load keeps it.
  breakJson           Json?
  /// The pallet need the load was planned with, in 1/1000 pallet (the sum of its rows'): set only
  /// on a load planned by pallets (a truck with bays, and the optimizer said so). NULL = planned by
  /// cases, or before pallets existed. Copied unchanged with a frozen load.
  palletUnits         Int?
  /// The load's cost breakdown under the one cost model (review F17, apps/solver/costing.py: the
  /// driver is paid for the whole truck day): fixed, trip, distance, fuel, driver share, overtime,
  /// paid minutes, estimated legs (lib/dispatch/costs.ts). Null on loads costed the earlier way
  /// (operatingCost then excludes depot turnaround, waiting and overtime).
  costJson            Json?
  carriedFromLoadId   String? // the same physical load in the parent plan version
  statusChangedAt     DateTime?
  statusChangedById   String?
  statusChangedBy     User?             @relation("PlanLoadStatusBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  // Who last set the driver in the Driver list or with Keep, and when (setDriverTx; "No driver"
  // too, which is not a hand-set driver). Carried by a re-plan's copies, and with a driver by
  // applyScenario to the same truck and trip. Null: RouteIQ filled it in.
  driverSetById       String?
  driverSetBy         User?             @relation("PlanLoadDriverSetBy", fields: [driverSetById], references: [id], onDelete: SetNull)
  driverSetAt         DateTime?
  /// (6 Oct 2026, driver leave) RouteIQ gave this driver as the cover of the truck's usual driver on
  /// leave (planDrivers, pass 3). A re-plan offers him again only as the cover - so he goes when the
  /// leave ends early, another cover is named or he drives another truck that day. Copied by a
  /// re-plan's copies; false for every other driver and once the dispatcher sets the driver.
  driverIsCover       Boolean           @default(false)
  /// (13 Oct 2026, helpers) Who last set the helpers in the plan screen's Helper(s) picker, and when
  /// ("No helpers" too). With at least one helper it is the dispatcher's choice: a re-plan keeps those
  /// helpers on this truck and trip (lib/dispatch/load-helpers.ts). Null: RouteIQ filled them in.
  helpersSetById      String?
  helpersSetBy        User?             @relation("PlanLoadHelpersSetBy", fields: [helpersSetById], references: [id], onDelete: SetNull)
  helpersSetAt        DateTime?
  createdAt           DateTime          @default(now())
  assignments         RouteAssignment[]
  helpers             PlanLoadHelper[]

  @@unique([runId, truckId, loadNo])
  @@index([tenantId, runId])
}

model ScenarioResult {
  id                String          @id @default(cuid())
  runId             String
  run               RunPlan         @relation(fields: [runId], references: [id], onDelete: Cascade)
  name              String
  trucksUsed        Int
  totalDistanceKm   Float
  totalTimeMin      Int
  totalCost         Float
  avgUtilizationPct Float
  unservedCount     Int
  detailsJson       Json
  unservedOrders    UnservedOrder[]
  createdAt         DateTime        @default(now())

  @@index([runId])
}

model RouteAssignment {
  id                        String         @id @default(cuid())
  runId                     String
  run                       RunPlan        @relation(fields: [runId], references: [id], onDelete: Cascade)
  truckId                   String
  truck                     Truck          @relation(fields: [truckId], references: [id])
  orderId                   String
  order                     Order          @relation(fields: [orderId], references: [id])
  sequenceInTruck           Int
  plannedArrivalMin         Int
  plannedDistanceFromPrevKm Float
  plannedLoadCases          Int
  lockedByUserId            String?
  lockedBy                  User?          @relation("RouteAssignmentLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  manualOverrideReason      String?
  deliveryProof             DeliveryProof?
  // --- dispatch MVP ---
  loadId                    String?
  load                      PlanLoad?      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  loadNo                    Int            @default(1)
  orderInStop               Int            @default(0) // several orders for one customer = one stop
  etaMin                    Int? // clock minutes from midnight
  serviceStartMin           Int?
  departureMin              Int?
  waitMin                   Int?
  cumulativeKm              Float?
  hardWindowOk              Boolean?
  prefWindowOk              Boolean?
  // --- split deliveries: a customer bigger than one truck is delivered in parts. A row with
  // portion fields carries only part of its order; null = the whole order. ---
  portionCases              Int?
  portionWeightKg           Float?
  portionLinesJson          Json? // [{ lineId, cases }] - exact SKU lines of this portion
  /// The row's pallet need as sent to the optimizer, in 1/1000 pallet (each line's cases / its cases
  /// per pallet, rounded up per line). NULL = planned without pallets (no truck with bays).
  palletUnits               Int?
  /// The customer facts this stop was planned with (pin, receiving hours, service time, name,
  /// address, access notes): lib/dispatch/snapshots.ts. Null on rows planned before snapshots
  /// existed (the live customer is shown, labelled as such).
  stopSnapshotJson          Json?

  @@unique([runId, truckId, loadNo, sequenceInTruck, orderInStop])
  @@index([runId, truckId])
  @@index([loadId])
  // The RESTRICT key on orderId: deleting an order looks here once per order. Every plan version
  // copies all its stops and nothing prunes them, so without this index a wrong file's delete
  // scanned the whole table per order and timed out after a few months (review db-schema-1).
  @@index([orderId])
}

model RunJob {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId        String
  run          RunPlan      @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptNo    Int          @default(1)
  status       RunJobStatus @default(QUEUED)
  progressPct  Int          @default(0)
  message      String?
  requestJson  Json?
  responseJson Json?
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?    @db.Timestamptz(3)
  finishedAt   DateTime?    @db.Timestamptz(3)
  errorJson    Json?
  /// QUICK or THOROUGH (owner decision 29 Sep 2026: night plans long, day re-plans quick). Null on
  /// jobs from before search modes (they searched QUICK).
  searchMode   String?
  /// The last sign of life of the web process running this job: written every 30 s while it waits
  /// for a solver slot or for the optimizer (lib/jobs/dispatch-job.ts). The stuck-plan check and
  /// the janitor use it, so a 20-minute search is never taken for a lost job.
  heartbeatAt  DateTime?    @db.Timestamptz(3)

  @@unique([runId, attemptNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([runId])
}

model ManualBaseline {
  id              String                     @id @default(cuid())
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId           String?
  run             RunPlan?                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  fileName        String?
  uploadedById    String
  uploadedBy      User                       @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime                   @default(now())
  totalTrucks     Int                        @default(0)
  totalDistanceKm Float?
  totalTimeMin    Int?
  totalCost       Float?
  notes           String?
  assignments     ManualBaselineAssignment[]

  @@index([tenantId, createdAt])
  @@index([tenantId, runId])
}

model ManualBaselineAssignment {
  id                  String         @id @default(cuid())
  baselineId          String
  baseline            ManualBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  orderId             String?
  order               Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  truckCode           String
  sequence            Int?
  customerCode        String
  branchKey           String         @default("__MAIN__")
  cases               Int            @default(0)
  estimatedDistanceKm Float?
  estimatedTimeMin    Int?

  @@index([baselineId, truckCode])
  // SET NULL on orderId: an order delete looks here once per order (review db-schema-1).
  @@index([orderId])
}

model UnservedOrder {
  id               String             @id @default(cuid())
  scenarioId       String
  scenario         ScenarioResult     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  orderId          String
  // NoAction: an order that is in any plan option cannot be deleted from under it (like
  // RouteAssignment.orderId). Deleting a tenant removes its plan data first.
  order            Order              @relation(fields: [orderId], references: [id], onDelete: NoAction)
  reasonCode       UnservedReasonCode
  reasonMessage    String?
  // Split deliveries: only part of the order is unserved (null = the whole order).
  portionCases     Int?
  portionWeightKg  Float?
  portionLinesJson Json? // [{ lineId, cases }]
  createdAt        DateTime           @default(now())

  @@index([scenarioId])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  // The Audit log page's user list (rows per user, read from this index alone) and the API's
  // filter by user, newest first (review db-schema-2).
  @@index([tenantId, userId, createdAt])
}

// --- Delivery outcome & driver page (owner request 4 Oct 2026) ---------------------------------
// One driver link (QR) per truck and delivery date opens the driver's phone page (app/d/[token]);
// arrivals, departures, results and photos are stop events. Spec: lib/driver-link/*, lib/delivery/*.
// The retired driver app's tables (DriverShift, TruckLocation, DeliveryProof) are not used.

enum StopEventKind {
  ARRIVED        // payload: chained?, observed (false = first seen when the page came back), resumed?
  DEPARTED       // payload: reason LEFT | NEXT_STOP, gap? (true = not observed: the page was away)
  OUTCOME        // payload: outcome (or null = result cleared), reason, note, lines, photoKeys, noPhotoReason?
  PHOTO          // payload: { photoId }
  BACK_AT_DEPOT  // load level: sequence is NULL
  CARRY_CONFLICT // a result change refused because the order was brought forward; ignored by deriveVisit
  // Load level (sequence NULL), on the load the truck leaves with: the driver's "Leaving for next load"
  // after Back at depot of his previous trip (owner decision 16 Oct 2026: alert rule R2 measures the
  // turnaround at the depot from these two taps). At most one per load.
  DEPOT_DEPART
}

enum PhotoPositionStatus {
  OK             // a fix with accuracy <= 100 m
  POOR           // a fix, accuracy > 100 m
  DENIED         // location permission refused
  TIMEOUT        // no fix within 15 s
  UNSUPPORTED    // no Geolocation in this browser
}

enum StopEventSource {
  PHONE_AUTO     // the driver page's geofence (no tap)
  PHONE_MANUAL   // the driver tapped (I have arrived, a result, a photo, Back at depot, Leaving for next load)
  DISPATCHER     // recorded or corrected on the plan screen
  AYUN           // later: Ayun GPS stop events
  SYSTEM         // derived by RouteIQ (for example the janitor completing a returned load)
}

enum DeliveryOutcome {
  DELIVERED
  PARTLY_DELIVERED
  NOT_DELIVERED
}

enum NotDeliveredReason {
  SHOP_CLOSED
  CUSTOMER_REFUSED
  NO_ONE_TO_RECEIVE
  WRONG_LOCATION      // "Wrong location or could not find"
  NO_TIME_LEFT
  PAYMENT_ISSUE
  DAMAGED_GOODS
  NOT_ON_TRUCK        // cases missing from the truck
  OTHER               // note required
}

/// One driver link per truck and delivery date. The token is never stored: tokenHash is its
/// SHA-256 (lookup), and the token is re-derived on the server from (id, generation, salt) and the
/// server key (lib/driver-link/token.ts), so the plan screen and every PDF can show it again.
model DriverLink {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  truckId          String
  /// NO ACTION: a truck with links is deactivated, never deleted.
  truck            Truck           @relation(fields: [truckId], references: [id], onDelete: NoAction)
  deliveryDate     DateTime        @db.Date
  generation       Int             @default(1)
  salt             String // 16 random bytes, base64url; new on every reissue
  keyId            String // first 8 hex of SHA-256(server key): resolve refuses a link made with an older key
  tokenHash        String          @unique // SHA-256 hex of the token
  /// The hash of the generation before the last reissue: that token answers 410 LINK_REPLACED
  /// (never counted as a bad token) instead of 404.
  prevTokenHash    String?         @unique
  expiresAt        DateTime        @db.Timestamptz(3) // reading and new results; uploads get +72 h
  issuedAt         DateTime        @default(now()) @db.Timestamptz(3)
  issuedById       String?
  issuedBy         User?           @relation("DriverLinkIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  /// The driver of the truck-day's first load not yet COMPLETED when (re)issued: "Reissue link?" prompt.
  driverIdAtIssue  String?
  revokedAt        DateTime?       @db.Timestamptz(3)
  revokedById      String?
  revokedBy        User?           @relation("DriverLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  lastSeenAt       DateTime?       @db.Timestamptz(3)
  /// Up to 5 browsers seen with this generation: [{ device: first 8 hex of sha256(deviceId), first, last }]
  /// (written at most every 5 min). The link dialog shows "used on N phones".
  devicesJson      Json?
  events           StopEvent[]
  photos           DeliveryPhoto[]

  @@unique([tenantId, truckId, deliveryDate])
  @@index([tenantId, deliveryDate])
}

/// The salesman link (owner request 19 Oct 2026): one no-login, read-only link per company and delivery
/// date for the salesmen's WhatsApp group (app/s/[token]). Each salesman types his route code (a filter,
/// not a password: the owner's choice, an accepted risk in docs/SECURITY.md) and follows his customers'
/// deliveries live. Only today's or tomorrow's date; works until 06:00 company time the day after the
/// delivery date. Only the token's SHA-256 is kept (lib/sales-link/token.ts); the token is never stored,
/// logged or audited. No foreign key to a truck or a plan: the page reads the plans in use every time.
model SalesLink {
  id            String    @id @default(cuid()) // newSalesLinkId() before the insert: the token is derived from it
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryDate  DateTime  @db.Date
  generation    Int       @default(1)
  salt          String // 16 random bytes, base64url; new on every reissue
  keyId         String // first 8 hex of SHA-256(server key): resolve refuses a link made with an older key
  tokenHash     String    @unique // SHA-256 hex of the token
  /// The hash of the generation before the last reissue: that token answers 410 LINK_REPLACED.
  prevTokenHash String?   @unique
  expiresAt     DateTime  @db.Timestamptz(3) // 06:00 company time on the day after the delivery date
  issuedAt      DateTime  @default(now()) @db.Timestamptz(3)
  issuedById    String?
  issuedBy      User?     @relation("SalesLinkIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedById   String?
  revokedBy     User?     @relation("SalesLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  lastSeenAt    DateTime? @db.Timestamptz(3)
  /// The browsers that opened this generation: a JSON array of the first 8 hex of SHA-256 of each page's
  /// random id (at most 200; "opened on N phones"), appended atomically. The location retention turns
  /// each into "" (the count stays).
  devicesJson   Json?
  /// The route codes looked up that had deliveries (normalised, at most 200), appended atomically: "routes
  /// looked up". Never a code that matched nothing.
  routesJson    Json?

  @@unique([tenantId, deliveryDate])
}

/// One physical stop of a load that left the depot: the current state, rebuilt from its events.
/// Keyed by the stop itself, never by a plan version's row (a re-plan copies the loads).
model StopVisit {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId             String
  deliveryDate        DateTime             @db.Date
  truckId             String
  truck               Truck                @relation(fields: [truckId], references: [id], onDelete: NoAction)
  loadNo              Int
  sequence            Int
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction)
  /// Traceability only (no FK): the PlanLoad row of the version the first event was recorded on.
  firstLoadId         String?
  // The plan as it was for this stop (copied at the first write; frozen loads never change):
  plannedEtaMin       Int?
  plannedServiceMin   Int? // departureMin - serviceStartMin (the scheduled unloading)
  plannedLat          Float?
  plannedLng          Float?
  windowStartMin      Int? // promised time, else the hard receiving window; null = any time
  windowEndMin        Int?
  /// [{ orderId, lineId, productCode, plannedCases, deliveredCases|null }] (readVisitLines)
  linesJson           Json
  casesPlanned        Int
  casesDelivered      Int? // null = no result
  // Timing (rebuilt from events):
  arrivedAt           DateTime?            @db.Timestamptz(3)
  arrivalSource       StopEventSource?
  arrivalDistanceM    Float?
  arrivalAccuracyM    Float?
  departedAt          DateTime?            @db.Timestamptz(3)
  departureSource     StopEventSource?
  departedAtOutcome   Boolean              @default(false) // no usable departure: the result time ended the stop
  /// false = the automatic arrival was first seen when the page came back (resumed), so its time
  /// is only an upper bound: never used for measured times or the on-time KPI.
  arrivalObserved     Boolean              @default(true)
  autoArrivedAt       DateTime?            @db.Timestamptz(3) // an OBSERVED automatic arrival only
  autoDepartedAt      DateTime?            @db.Timestamptz(3) // an OBSERVED automatic departure only
  autoBasis           String? // 'DEPARTURE' | 'RESULT': what ended the automatic timing
  autoMinutes         Float? // observed auto arrival -> observed departure, else -> the driver's result time
  autoServiceMinutes  Float? // the same, from max(arrival, window start), break excluded
  /// Plausibility flags of the phone-reported positions: any flag excludes the visit from
  /// measured times, the on-time KPI and the pin check. The overlay says "unverified timing".
  timingSuspect       Boolean              @default(false)
  // Result (rebuilt from the latest OUTCOME event):
  outcome             DeliveryOutcome?
  reason              NotDeliveredReason?
  reasonNote          String?
  outcomeAt           DateTime?            @db.Timestamptz(3)
  outcomeSource       StopEventSource?
  outcomeById         String?
  outcomeBy           User?                @relation("StopVisitOutcomeBy", fields: [outcomeById], references: [id], onDelete: SetNull)
  outcomeLat          Float?
  outcomeLng          Float?
  outcomeAccuracyM    Float?
  outcomeDistanceM    Float?
  /// The current result came from an event received after the load was COMPLETED or after the
  /// link expired: shown "recorded after the trip closed", never ticked in Bring forward.
  outcomeLate         Boolean              @default(false)
  noPhotoReason       String? // 'CAMERA_FAILED' (the driver's only exception to "photo required")
  photoKeysJson       Json? // photo keys the result named (shows "photo not received yet")
  photoCount          Int                  @default(0)
  // The driver's own last Delivered or Partly result (owner decision 2 of 5 Oct 2026), rebuilt from the
  // events the driver link sent. A result the office records (Record) never changes these four, so a
  // result the driver saved without a photo stays on the lists, the KPI and the Excel after a correction
  // (lib/delivery/camera-exceptions.ts).
  driverResultAt      DateTime?            @db.Timestamptz(3)
  driverResultOutcome DeliveryOutcome?
  driverNoPhotoReason String? // 'CAMERA_FAILED': that result was saved with "Camera not working"
  driverPhotoKeys     Int                  @default(0) // photo keys named by the driver's Delivered / Partly results
  /// Owner request 19 Oct 2026 (GPS study, the leave-and-return guard): minutes the truck was away from the
  /// customer between the shown arrival and departure, by its GPS stays (beyond 500 m of the pin, or at
  /// another customer, and back: lib/delivery/visit.ts awayMinutesOf). Never unloading: every unloading
  /// time and UNLOAD_OVER use departure - arrival - awayMinutes. NULL = none (every visit without GPS).
  /// Rebuilt with the visit; CHECK "StopVisit_awayMinutes_range" (NULL, or more than 0 and at most 1440).
  awayMinutes         Float?
  /// Owner decision 21 Oct 2026 ("GPS arrival should win of course"; the GPS timing study of 19-20 Oct): a GPS
  /// (AYUN) time now REPLACES a late phone time (lib/delivery/visit.ts F1, F4, F5, and the result standing in for
  /// a departure, F2). The driver's and the office's own times it replaced, as their events alone gave them
  /// (deriveOwnVisit), so the visit "without GPS" stays exact (withoutGpsTimes: alerts below ALERTS, turnaround,
  /// analysis) and the driver page, the photo check, the office's Left check and the KPI read the driver's own
  /// arrival (ownArrivalOf). Set only when arrivalSource is AYUN and an own arrival existed; never AYUN itself
  /// (CHECKs "StopVisit_ownArrival_pair", "StopVisit_ownArrival_notGps"). Read only under an AYUN arrivalSource:
  /// a row an older version rebuilt (stale) is harmless. ownArrivalAccuracyM is erased with the positions.
  ownArrivedAt        DateTime?            @db.Timestamptz(3)
  ownArrivalSource    StopEventSource?
  ownArrivalDistanceM Float?
  ownArrivalAccuracyM Float?
  ownArrivalObserved  Boolean?
  /// The own departure a GPS departure replaced (a real one or the result standing in for it), set only when
  /// departureSource is AYUN and an own one existed (CHECKs "StopVisit_ownDeparture_pair", "..._notGps").
  ownDepartedAt       DateTime?            @db.Timestamptz(3)
  ownDepartureSource  StopEventSource?
  ownDepartedAtOutcome Boolean?
  /// F2: minutes the truck still stood at the stop after the driver's result, when the GPS departure shown is
  /// more than 15 min after it (the time away in that span taken off). Never unloading: every unloading time
  /// ends at the result (departure - arrival - awayMinutes - afterResultMinutes). NULL = none. CHECK
  /// "StopVisit_afterResultMinutes_range" (NULL, or more than 0 and at most 1440).
  afterResultMinutes  Float?
  locationPurgedAt    DateTime?            @db.Timestamptz(3) // lat/lng/accuracy erased; distances kept
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  events              StopEvent[]
  photos              DeliveryPhoto[]

  @@unique([tenantId, depotId, deliveryDate, truckId, loadNo, sequence])
  @@index([tenantId, deliveryDate])
  @@index([tenantId, customerId, deliveryDate])
}

/// Append-only log: what happened at a stop, from which source. Ayun (later) writes here too.
model StopEvent {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId         String
  deliveryDate    DateTime        @db.Date
  truckId         String
  loadNo          Int
  sequence        Int? // NULL = load level (BACK_AT_DEPOT, DEPOT_DEPART)
  visitId         String?
  visit           StopVisit?      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind            StopEventKind
  source          StopEventSource
  at              DateTime        @db.Timestamptz(3) // when it happened (device clock, corrected and clamped)
  receivedAt      DateTime        @default(now()) @db.Timestamptz(3)
  lat             Float?
  lng             Float?
  accuracyM       Float?
  distanceM       Float? // from the stop's planned pin (the depot pin for BACK_AT_DEPOT and DEPOT_DEPART)
  speedMps        Float?
  driverLinkId    String?
  driverLink      DriverLink?     @relation(fields: [driverLinkId], references: [id], onDelete: SetNull)
  linkGeneration  Int?
  userId          String?
  user            User?           @relation("StopEventUser", fields: [userId], references: [id], onDelete: SetNull)
  clientIp        String? // as AuditLog: who sent it (erased with the location)
  deviceId        String? // sha256 of the page's random per-browser id, first 16 hex (erased with the location)
  /// Namespaced on the server so sources cannot collide: "dl:<uuid>" (driver action),
  /// "dlphoto:<uuid>" (driver photo), "disp:<uuid>" (dispatcher), "ayun:<id>" (later).
  idempotencyKey  String
  payloadJson     Json? // also: late, clockSkewMs, gpsAt, suspect[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, deliveryDate, truckId])
  @@index([visitId, at])
  /// The janitor's returned-loads sweep (kind BACK_AT_DEPOT, newest first).
  @@index([kind, receivedAt])
  /// The location retention sweep (per company, by receipt time).
  @@index([tenantId, receivedAt])
}

/// A delivery photo: compressed JPEG in the database. bytes = NULL once the retention janitor
/// dropped it; the metadata stays.
model DeliveryPhoto {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId          String
  visit            StopVisit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  idempotencyKey   String
  source           StopEventSource
  driverLinkId     String?
  driverLink       DriverLink?         @relation(fields: [driverLinkId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?               @relation("DeliveryPhotoUser", fields: [userId], references: [id], onDelete: SetNull)
  clientIp         String?
  deviceId         String?
  /// The capture time on the device clock, skew-corrected and clamped to
  /// [zonedDayStart(date) - 6 h, receivedAt]. The raw value is in rawTakenAt.
  takenAt          DateTime            @db.Timestamptz(3)
  rawTakenAt       DateTime?           @db.Timestamptz(3)
  receivedAt       DateTime            @default(now()) @db.Timestamptz(3) // server time: retention runs on it
  positionStatus   PhotoPositionStatus
  lat              Float?
  lng              Float?
  accuracyM        Float?
  distanceM        Float?
  exifLat          Float?
  exifLng          Float?
  exifTakenAt      DateTime?           @db.Timestamptz(3) // parsed with OffsetTimeOriginal, else the tenant time zone
  exifDistanceM    Float?
  oldPhoto         Boolean             @default(false) // EXIF time or file time > 15 min before the arrival / dispatch
  contentType      String              @default("image/jpeg")
  byteSize         Int // of the stored (metadata-stripped) bytes
  width            Int?
  height           Int?
  sha256           String // of the stored (metadata-stripped) bytes
  bytes            Bytes?
  purgedAt         DateTime?           @db.Timestamptz(3)
  locationPurgedAt DateTime?           @db.Timestamptz(3)

  @@unique([tenantId, idempotencyKey])
  @@index([visitId])
  @@index([tenantId, receivedAt])
  /// The daily photo cap per driver link.
  @@index([driverLinkId])
}

/// Operations alerts (owner request 16 Oct 2026: "notify me when a rule I set is broken"). One row per rule
/// and physical subject: `subjectKey` is depot|date|truck|loadNo[|seq] (a stop or a load) or
/// depot|date|truck (a truck-day), never a PlanLoad id, so a re-plan's copies keep their rows
/// (lib/alerts/catalog.ts subjectKeyOf). Written only by the alert sweep (lib/alerts/store.ts), with
/// duplicates refused by the unique key (two sweeps during a deploy overlap raise one row);
/// acknowledged in the app. Nothing that plans or delivers reads it. States (lib/alerts/types.ts
/// alertStateOf): a CONDITION row is open until its condition ends (resolvedAt); an EVENT row is open until
/// it is acknowledged or corrected; resolvedReason says why a row closed. Rows hold customer names and
/// shortened driver notes (digit runs removed, never a phone number): 90 days after their date the janitor
/// removes them (text '', facts but "by GPS", the cause & action's free texts; detailsRemovedAt) and closes a
/// row still open, and deletes the row once it is older than the analysis data's retention (at least 90
/// days; owner request 20 Oct 2026: the cause & action is decision data). Start fresh deletes the day's rows.
model OpsAlert {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// No foreign key: the rows are history; Start fresh and hired one-day trucks delete freely.
  depotId        String
  deliveryDate   DateTime  @db.Date
  /// A code of lib/alerts/catalog.ts ALERT_RULES (checked in the app, not by a CHECK: a new rule needs no migration).
  rule           String
  subjectKey     String
  truckId        String
  /// As shown (a hired truck's plate) when the row was raised.
  truckCode      String
  loadNo         Int?
  sequence       Int?
  customerId     String?
  /// 'CONDITION' | 'EVENT' (CHECK).
  kind           String
  /// 'WARN' | 'HIGH' (CHECK): tier 1 is WARN, tier 2 and 3 are HIGH (lib/alerts/catalog.ts severityOf).
  severity       String
  tier           Int       @default(1)
  /// Minutes, metres or the priority, as the rule measures it; threshold = the setting it was compared with.
  value          Int
  threshold      Int
  /// Plain English, built by lib/alerts/text.ts; the final words once the row is resolved.
  text           String
  factsJson      Json?
  /// The current tier may pop up as a toast / go in an e-mail (lib/alerts/catalog.ts deliveryOf).
  mayToast       Boolean   @default(true)
  mayEmail       Boolean   @default(true)
  /// When the condition began or the event happened (no row for anything before TenantConfig.alertsEnabledAt).
  occurredAt     DateTime  @db.Timestamptz(3)
  firstSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  /// lib/alerts/catalog.ts RESOLVED_REASONS: ENDED, CORRECTED, NOT_IN_PLAN, EXPIRED, RULE_OFF.
  resolvedReason String?
  occurrences    Int       @default(1)
  ackedAt        DateTime? @db.Timestamptz(3)
  ackedById      String?
  ackedBy        User?     @relation("OpsAlertAckedBy", fields: [ackedById], references: [id], onDelete: SetNull)
  /// Cause & action (owner request 20 Oct 2026, lib/alerts/review.ts): what the office found after checking the
  /// alert and what it decided. Written only by PATCH /api/alerts (never the sweep, the e-mail or the ack);
  /// every save audited (ALERT_REVIEW_SAVED, codes only). All NULL (follow-up false, saves 0) = none recorded
  /// (CHECK OpsAlert_review_whole). Codes: an upper-case word (CHECK on the format, the lists are the app's).
  reviewCause       String?
  /// Only with cause OTHER, 3-120 characters (CHECKs), digit runs removed; removed after 90 days.
  reviewCauseOther  String?
  reviewAction      String?
  reviewActionOther String?
  /// 1-500 characters, one line, digit runs removed; removed after 90 days.
  reviewNote        String?
  reviewFollowUp    Boolean   @default(false)
  reviewFirstAt     DateTime? @db.Timestamptz(3)
  reviewFirstById   String?
  reviewFirstBy     User?     @relation("OpsAlertFirstReviewedBy", fields: [reviewFirstById], references: [id], onDelete: SetNull)
  /// The last save; a save names the reviewedAt it was based on (two editors: the second gets 409).
  reviewedAt        DateTime? @db.Timestamptz(3)
  reviewedById      String?
  reviewedBy        User?     @relation("OpsAlertReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// How many saves (1 = never edited).
  reviewSaves       Int       @default(0)
  /// The alert whose save also filled this one (one incident: the alerts of a truck and day saved together); no foreign key.
  reviewGroupId     String?
  /// The alert's tier, occurrences and customer at the last save: it came back, got worse or names another stop since.
  reviewTier        Int?
  reviewOccurrences Int?
  reviewCustomerId  String?
  /// When the 90-day clean-up removed the text, the facts and the cause & action's free texts (the row is then read-only).
  detailsRemovedAt  DateTime? @db.Timestamptz(3)
  /// The tier last e-mailed (0 = never); the e-mail claim takes rows with emailedTier < tier.
  emailedTier    Int       @default(0)
  emailedAt      DateTime? @db.Timestamptz(3)
  /// The OpsAlertDigest that last carried it (no foreign key).
  digestId       String?
  emailAttempts  Int       @default(0)
  emailError     String?

  @@unique([tenantId, rule, subjectKey])
  @@index([tenantId, deliveryDate])
  @@index([tenantId, resolvedAt, ackedAt])
  @@index([tenantId, lastSeenAt])
}

/// One alert e-mail per row (owner request 16 Oct 2026, lib/alerts/notify.ts): the throttle ("at most one
/// e-mail every N min") and the daily cap count these rows, inside the claim's transaction. Counts only:
/// never an address or an alert text.
model OpsAlertDigest {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  /// 'SENDING' | 'SENT' | 'FAILED' (CHECK).
  status         String    @default("SENDING")
  alertCount     Int
  highCount      Int
  recipientCount Int
  sentAt         DateTime? @db.Timestamptz(3)
  /// The provider's status code or a short reason; never an address.
  error          String?

  @@index([tenantId, createdAt])
}

// IVMS live link (Ayun, a GPS-Server.net tracking platform), 16 Oct 2026: lib/ivms/*. Off by default
// (TenantConfig.ivmsMode OFF, kill switch ROUTEIQ_DISABLE_IVMS=1): while OFF nothing here is written
// and RouteIQ makes no call to Ayun. Only trucks with a tracker IMEI (Truck.ivmsImei) are ever asked
// for or stored; provider object names (they hold driver names), plates, SIMs and the like are never
// stored. Driver and office entries always win over GPS; GPS never writes a result and never completes
// a load. Every model below is tenant-scoped (lib/tenant.ts).

/// The latest live position of a truck (one row, updated in place): the live map (MAP) only, never a
/// source of arrival or departure times. Written only while the truck has a load out (LOCKED, LOADING
/// or DISPATCHED); a truck without one has no row. Deleted when the tracker is moved to another truck.
model TruckPosition {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  truckId    String    @unique
  truck      Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  /// The device's GPS time of the fix (provider dt_tracker, UTC, plus AYUN_API_TIME_OFFSET_MIN).
  fixAt      DateTime  @db.Timestamptz(3)
  /// When the provider received it (dt_server); fixAt far behind it = a delayed (buffered) fix.
  serverAt   DateTime? @db.Timestamptz(3)
  /// When RouteIQ read it (the poll): the map's "updated N min ago" and the retention purge.
  receivedAt DateTime  @db.Timestamptz(3)
  lat        Float
  lng        Float
  speedKmh   Float?
  heading    Int?
  /// The device's ignition input when it sends one (params.acc), else NULL.
  ignition   Boolean?
  /// lib/ivms/types.ts FIX_FLAGS: INVALID_FIX | CLOCK_AHEAD | DELAYED (database CHECK).
  flags      String[]  @default([])
  /// The last fix moving at 5 km/h or more ("parked for N min").
  movedAt    DateTime? @db.Timestamptz(3)

  @@index([tenantId, receivedAt])
}

/// A truck's GPS trail from the provider's history (OBJECT_GET_ROUTE): the only source of GPS
/// arrival and departure times (TIMES). Pulled only while the truck has a load out and once at the
/// end; kept TenantConfig.ivmsTrailDays (default 2) days; never exported; shown only to the dispatcher
/// and up, as the line of a truck's day (owner request 18 Oct 2026, lib/ivms/truck-day.ts, at most 2,000
/// points). Invalid fixes (out of range, 0,0, clock ahead) are never stored.
model TruckTrailPoint {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  truckId  String
  truck    Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  /// The device's GPS time (UTC, plus AYUN_API_TIME_OFFSET_MIN). The same fix pulled twice is one row.
  fixAt    DateTime @db.Timestamptz(3)
  lat      Float
  lng      Float
  speedKmh Float?
  ignition Boolean?

  @@unique([tenantId, truckId, fixAt])
  @@index([tenantId, fixAt])
}

/// Depot and zone moves of trucks with a tracker: Ayun webhooks, the OBJECT_GET_LAST_EVENTS backstop,
/// or derived from the trail. Only for IMEIs mapped to a truck of this company (an unknown IMEI is
/// counted, never stored). A fact for the screen (and later the alerts): never a load completion.
model IvmsEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  truckId     String
  truck       Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  /// The matched depot of this company (no FK, like StopVisit.depotId); NULL = not a depot zone.
  depotId     String?
  /// lib/ivms/types.ts IVMS_EVENT_KINDS: DEPOT_IN | DEPOT_OUT | ZONE_IN | ZONE_OUT (database CHECK).
  kind        String
  /// lib/ivms/types.ts IVMS_EVENT_ORIGINS: WEBHOOK | BACKSTOP | TRAIL (database CHECK).
  origin      String
  /// When it happened: the fix's dt_tracker (+ the channel's offset), or the first trail point in/out.
  eventAt     DateTime  @db.Timestamptz(3)
  serverAt    DateTime? @db.Timestamptz(3)
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  /// The provider zone's name, at most 80 characters (database CHECK).
  zoneName    String?
  /// Display only: never a pin, never pin evidence, never a stop-detection input.
  lat         Float?
  lng         Float?
  /// 'ayun:' + a hash of (imei, type, dt_tracker, zone) (lib/ivms/dedupe.ts): a webhook and the
  /// backstop row of the same event are one row.
  dedupeKey   String
  processedAt DateTime? @db.Timestamptz(3)
  /// lib/ivms/types.ts IVMS_EVENT_OUTCOMES: what processing did with it (NULL = not processed yet).
  outcome     String?
  /// A TRAIL move only: its time is exact (a trail point at most observedMaxGapSec before it), decided by
  /// the stop detector when it writes the move (GPS alerts, review of 18 Oct 2026, finding 6: never worked
  /// out again from trail points the retention deletes). NULL: a zone move (the device's own event, exact),
  /// or a trail move written before migration 20261018130000_ivms_move_observed (read against the trail).
  observed    Boolean?

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, truckId, eventAt])
  @@index([tenantId, processedAt])
  @@index([tenantId, receivedAt])
}

/// One row per company with the IVMS link on: the provider allowance used today, per call class, so
/// that no class can starve another (lib/ivms/budget.ts); the lease that lets one container call at a
/// time (released after each call); the backoff after failures; the webhook counters. Counted in the
/// database, so a restart or two containers during a deploy never go over the allowance. Never
/// deleted by Start fresh (the provider's count for the day would be lost).
model IvmsState {
  tenantId        String    @id
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The provider's day: the UTC date (it resets its counters at 00:00 UTC, 04:00 in Muscat).
  usageDay        DateTime  @db.Date
  /// Calls made on usageDay per class (lib/ivms/types.ts IVMS_CALL_CLASSES); failed calls count too.
  mapCalls        Int       @default(0) // OBJECT_GET_LOCATIONS: live positions (MAP)
  routeCalls      Int       @default(0) // OBJECT_GET_ROUTE: history pulls (TIMES)
  eventCalls      Int       @default(0) // OBJECT_GET_LAST_EVENTS: backstop for missed webhooks
  adminCalls      Int       @default(0) // USER_GET_OBJECTS / USER_GET_ZONES: the admin's mapping dialogs
  /// A background call in progress (deploy overlap): released when the call ends, expires on its own.
  leaseUntil      DateTime? @db.Timestamptz(3)
  leaseOwner      String?
  mapLastAt       DateTime? @db.Timestamptz(3)
  eventsLastAt    DateTime? @db.Timestamptz(3)
  lastOkAt        DateTime? @db.Timestamptz(3)
  /// Backoff: no background call before this (LIMIT: the next UTC midnight; AUTH: one hour).
  nextTryAt       DateTime? @db.Timestamptz(3)
  failures        Int       @default(0)
  /// An error kind code only (lib/ivms/types.ts AYUN_ERROR_KINDS), never a URL, a key or a body.
  lastError       String?
  lastErrorAt     DateTime? @db.Timestamptz(3)
  webhooksToday   Int       @default(0)
  /// Webhooks answered but not stored: unknown IMEI or type, mode OFF.
  webhooksIgnored Int       @default(0)
  /// Webhooks refused for their time (outside [now - 26 h, now + 2 min]): a wrong offset shows here.
  webhooksBadTime Int       @default(0)
  /// The provider's clock as seen in the last live-position answer: its newest receipt time (dt_server,
  /// with the API offset) minus RouteIQ's clock, seconds; about +-14400 = provider times not in UTC.
  providerSkewSec Int?
  /// When providerSkewSec was measured, and with which AYUN_API_TIME_OFFSET_MIN: GPS times are processed
  /// only while a skew measured with the offset in use is within limits (lib/ivms/budget.ts clockCheck,
  /// first review H-1; migration 20261016220000_ivms_review_fixes).
  providerSkewAt        DateTime? @db.Timestamptz(3)
  providerSkewOffsetMin Int?
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// One truck-day (delivery date) seen by the IVMS link: how far its history has been pulled (TIMES),
/// and whether GPS is suppressed for it (undo, a tracker that does not match the phone, a remap): a
/// suppressed truck-day gets nothing automatic written, and the next pass does not write it again.
model IvmsTruckDay {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  truckId        String
  truck          Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime  @db.Date
  /// History pulled up to this provider time; the next pull starts a little before it.
  pulledTo       DateTime? @db.Timestamptz(3)
  lastPullAt     DateTime? @db.Timestamptz(3)
  pulls          Int       @default(0)
  /// The pull after the truck-day's last load came back: no more pulls for it after this.
  finalPullAt    DateTime? @db.Timestamptz(3)
  /// When the stop detector last ran over this truck-day.
  processedAt    DateTime? @db.Timestamptz(3)
  suppressedAt   DateTime? @db.Timestamptz(3)
  /// lib/ivms/types.ts IVMS_SUPPRESS_REASONS: UNDO | MISMATCH | REMAP (database CHECK).
  suppressReason String?
  /// What the stop detector saw but must not write by itself (lib/ivms/stops.ts StopAmbiguity and
  /// notes, review H4): a fact for the office, never a time. A JSON array, at most 8 KB (CHECK);
  /// rewritten by each detector run (migration 20261016210000_ivms_gps_facts).
  gpsFactsJson   Json?
  /// The tracker was mapped to this truck at this time (it had none before): no point from before it is
  /// pulled or used, so a tracker moved from another truck never brings that truck's morning along
  /// (second review M-1; migration 20261016220000_ivms_review_fixes).
  trailFrom      DateTime? @db.Timestamptz(3)

  @@unique([tenantId, truckId, deliveryDate])
  @@index([tenantId, deliveryDate])
}

// The analysis dataset (owner request 19 Oct 2026: "build on more data for our analysis later and
// improvement"; the GPS study of 19 Oct 2026). The trucks' GPS trail is kept only ivmsTrailDays (2 by
// default), and a StopVisit keeps only its final rebuilt times and result: what the study could tell apart
// (a second drop point, a pin 200 m off, a late result tap, a trip out and back) is gone two days later.
// These four tables keep, per delivery date, small facts derived from the plan, the visits, the driver's
// taps and the trail, for TenantConfig.analysisRetentionDays (730 by default). Written only by the nightly
// job (lib/analysis/job.ts, about 03:00 company time for the day before, while the trail still exists);
// the columns that do not come from the trail are refreshed until 4 days after the delivery date (late
// results), then the rows are frozen (frozenAt). Never a raw position: a standing spot is kept as a
// distance and a bearing from the customer's pin, never a truck latitude or longitude. Every row keeps the
// plan values and the settings in force when it was built (serviceMinPerCase, reloadMinutes, the stop
// radius, the dwell, the detector version), so a later change of a setting never rewrites history.
// Tenant-scoped (lib/tenant.ts); no foreign key to a truck, customer or depot (history: master data may be
// deactivated or removed). Read only by the "Analysis data" export (GET /api/analysis/export, PLANNER).

/// One truck and delivery date: time out, km, time at customer sites, moving and idle, overtime, loads.
model FactTruckDay {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The depot of the truck's first load that day (no foreign key, like StopVisit.depotId).
  depotId            String
  deliveryDate       DateTime  @db.Date
  truckId            String
  /// As shown that day (a hired truck's own plate).
  truckCode          String
  /// The truck had a GPS tracker (Truck.ivmsImei) when the facts were built.
  tracked            Boolean   @default(false)
  loads              Int
  stopsPlanned       Int
  stopsWithResult    Int
  delivered          Int
  partlyDelivered    Int
  notDelivered       Int
  casesPlanned       Int
  casesDelivered     Int
  /// The plan: first departure and last return (local minutes), minutes out and km (PlanLoad).
  plannedDepartMin   Int?
  plannedReturnMin   Int?
  plannedOutMin      Int?
  plannedKm          Float?
  /// GPS (null without a usable trail): the first depot OUT and the last depot IN of the delivery date's trips (a
  /// trip that left the evening before is the day before's; a truck out overnight with this day's load counts
  /// from its first move after midnight).
  firstOutAt         DateTime? @db.Timestamptz(3)
  lastInAt           DateTime? @db.Timestamptz(3)
  /// TRAIL (the trail's own depot IN) or DEVICE_EVENT (the tracker's depot IN when the trail ended before
  /// the truck came back): CHECK.
  lastInFrom         String?
  outMin             Float?
  /// outMin over overtimeAfterMin (the setting in force, below).
  overtimeMin        Float?
  kmGps              Float?
  movingMin          Float?
  /// The customer sites of the day's visits (lib/analysis/gps.ts site spans), overlaps counted once.
  atSitesMin         Float?
  /// Standstills of 3 min or more away from every customer site and the depot: a count and minutes only.
  idleStops          Int?
  idleMin            Float?
  gpsTrips           Int?
  /// The trail's quality: points, first and last fix time, the longest gap, minutes in gaps over 5 min,
  /// frozen-position runs (the same position repeated for 60 s or more at 5 km/h or more), single-point
  /// spikes (a pairwise check, never a plain speed filter) and whether any point carried the ignition, over the
  /// date's own trail (from its midnight; the 3 h before are read only for the detector).
  trailPoints        Int       @default(0)
  trailFrom          DateTime? @db.Timestamptz(3)
  trailTo            DateTime? @db.Timestamptz(3)
  maxGapMin          Float?
  gapMinOver5        Float?
  frozenRuns         Int?
  frozenMin          Float?
  spikes             Int?
  ignitionSeen       Boolean?
  /// Why the GPS columns are empty: NO_TRACKER, NO_TRAIL, SUPPRESSED, PARTIAL_TRAIL (built late: the start of the
  /// trail already deleted by the GPS retention, so none of it is used) (CHECK).
  gpsNote            String?
  // The settings in force when built (kept on refresh).
  overtimeAfterMin   Int
  serviceMinPerCase  Float
  reloadMinutes      Int
  loadingMinPerCase  Float
  distanceMultiplier Float
  avgSpeedKmh        Float
  roadTimeFactor     Float
  stopRadiusM        Int
  dwellMin           Int
  detectorVersion    String
  analysisVersion    String
  builtAt            DateTime  @db.Timestamptz(3)
  /// When the GPS columns were computed (null: no usable trail then). Computed again only at a refresh, when the
  /// trail was pulled again after it (a late final pull) and is still whole; otherwise copied as they are.
  gpsBuiltAt         DateTime? @db.Timestamptz(3)
  refreshedAt        DateTime  @db.Timestamptz(3)
  /// Set at the last refresh (4 days after the delivery date): the row is never written again.
  frozenAt           DateTime? @db.Timestamptz(3)

  @@unique([tenantId, deliveryDate, truckId])
  @@index([tenantId, deliveryDate])
}

/// One planned stop of a load that left (the StopVisit key): plan against actual, wait, unloading on site
/// and by taps, the GPS sub-stays, the result and its changes, a late result tap, a pin offset.
model FactVisit {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId            String
  deliveryDate       DateTime  @db.Date
  truckId            String
  loadNo             Int
  sequence           Int
  customerId         String
  /// The StopVisit row (no foreign key: traceability only); null when the stop has no visit row.
  visitId            String?
  truckCode          String
  customerCode       String
  /// The customer type, and the base unloading time the planner gives the stop before the per-case time (its
  /// confirmed time, else its type's, else the company default: lib/analysis/job.ts baseServiceOf; null: untyped /
  /// not known).
  customerType       String?
  baseServiceMin     Int?
  // The plan (frozen).
  plannedEtaMin      Int?
  plannedServiceMin  Int?
  windowStartMin     Int?
  windowEndMin       Int?
  plannedKmFromPrev  Float?
  casesPlanned       Int
  /// The stop's place in the order the truck really drove (by the arrival RouteIQ holds), 1-based.
  actualOrder        Int?
  // As RouteIQ holds the visit (sources: StopEventSource names).
  arrivedAt          DateTime? @db.Timestamptz(3)
  arrivalSource      String?
  departedAt         DateTime? @db.Timestamptz(3)
  departureSource    String?
  departedAtOutcome  Boolean   @default(false)
  /// The arrival (local minutes) minus the planned ETA.
  arrivalVsEtaMin    Float?
  // The result and its changes.
  outcome            String?
  reason             String?
  outcomeAt          DateTime? @db.Timestamptz(3)
  outcomeSource      String?
  /// The first result saved (CLEARED when the first OUTCOME event cleared it) and when.
  firstOutcome       String?
  firstOutcomeAt     DateTime? @db.Timestamptz(3)
  outcomeEvents      Int       @default(0)
  resultChanged      Boolean   @default(false)
  casesDelivered     Int?
  /// The driver's result tap the truck's distance was measured at, and that distance from the pin (GPS).
  resultTapAt        DateTime? @db.Timestamptz(3)
  truckDistAtResultM Float?
  /// The truck was more than 500 m from the pin at the driver's result tap (null: not known).
  lateResultTap      Boolean?
  // The GPS customer site (lib/analysis/gps.ts): from the first point on site to leaving it.
  siteStartAt        DateTime? @db.Timestamptz(3)
  siteEndAt          DateTime? @db.Timestamptz(3)
  onSiteMin          Float?
  /// Trips away from the site and back (beyond 500 m, or nearer another customer's pin): never unloading.
  awayCount          Int?
  awayMin            Float?
  /// [{ startOffsetSec, minutes, maxDistM }] from siteStartAt (CHECK: a JSON array, at most 8 KB).
  awayJson           Json?
  /// Slow periods of 2 min or more on site: [{ startOffsetSec, minutes, distM, bearingDeg }] (CHECK as above).
  substays           Int?
  substaysJson       Json?
  /// Sub-stays more than 50 m apart.
  dropPoints         Int?
  /// The furthest the truck stood from the pin on site, and the closest it came.
  maxDistM           Float?
  closestM           Float?
  /// Where it stood to unload (the sub-stay holding the result tap, else the longest): from the pin only.
  standDistM         Float?
  standBearingDeg    Float?
  /// The truck stood 120-500 m from the pin to unload, longer than within 120 m of it (null: not known): the pin
  /// may be wrong (office review). A big site's second drop point after a drop at the pin is not one.
  pinOffset          Boolean?
  /// The live detector's stays (lib/ivms/stops.ts staysAt) inside the site.
  detectorStays      Int?
  // Unloading, minutes: never negative (CHECK).
  servedBeforeWindow Boolean?
  waitMin            Float?
  /// On site after the window opened, less the time away (GPS site start and end).
  unloadSiteMin      Float?
  /// From the arrival to the departure as RouteIQ holds them (window clipped on both sides).
  unloadVisitMin     Float?
  /// The same from the driver's and the office's own times (GPS left out: by taps).
  unloadTapMin       Float?
  unloadMin          Float?
  /// GPS_SITE or VISIT (CHECK).
  unloadSource       String?
  usableForRate      Boolean   @default(false)
  /// (unloadMin - baseServiceMin) / cases delivered, 0 when shorter than the base (analysis-v1 rows: unloadMin / cases).
  minPerCase         Float?
  /// lib/analysis/types.ts FACT_VISIT_FLAGS (CHECK).
  flags              String[]  @default([])
  // The settings in force when built.
  serviceMinPerCase  Float
  reloadMinutes      Int
  stopRadiusM        Int
  dwellMin           Int
  detectorVersion    String
  analysisVersion    String
  builtAt            DateTime  @db.Timestamptz(3)
  gpsBuiltAt         DateTime? @db.Timestamptz(3)
  refreshedAt        DateTime  @db.Timestamptz(3)
  frozenAt           DateTime? @db.Timestamptz(3)

  @@unique([tenantId, depotId, deliveryDate, truckId, loadNo, sequence])
  @@index([tenantId, deliveryDate])
  @@index([tenantId, customerId, deliveryDate])
}

/// One drive of a load in the order driven (depot -> stop, stop -> stop, stop -> depot): planned against
/// actual drive minutes and km, the time of day.
model FactLeg {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId            String
  deliveryDate       DateTime  @db.Date
  truckId            String
  truckCode          String
  loadNo             Int
  legNo              Int
  /// The stop numbers; null = the depot.
  fromSeq            Int?
  toSeq              Int?
  /// The two stops are consecutive in the plan (null for a leg from or to the depot).
  inPlanOrder        Boolean?
  /// Left the stop (or the depot) and reached the next (GPS site or trip times, else the visit's).
  leftAt             DateTime? @db.Timestamptz(3)
  arrivedAt          DateTime? @db.Timestamptz(3)
  leftMin            Int?
  hourOfDay          Int?
  driveMin           Float?
  /// From the departure to the next arrival as RouteIQ holds them.
  driveMinVisit      Float?
  plannedDriveMin    Int?
  kmGps              Float?
  plannedKm          Float?
  /// Pin to pin, as the crow flies.
  kmStraight         Float?
  /// SHARED_SITE, TRAIL_ENDED, NO_GPS, PLAN_HAS_IDLE (space separated).
  note               String?
  serviceMinPerCase  Float
  reloadMinutes      Int
  distanceMultiplier Float
  avgSpeedKmh        Float
  roadTimeFactor     Float
  stopRadiusM        Int
  dwellMin           Int
  detectorVersion    String
  analysisVersion    String
  builtAt            DateTime  @db.Timestamptz(3)
  gpsBuiltAt         DateTime? @db.Timestamptz(3)
  refreshedAt        DateTime  @db.Timestamptz(3)
  frozenAt           DateTime? @db.Timestamptz(3)

  @@unique([tenantId, depotId, deliveryDate, truckId, loadNo, legNo])
  @@index([tenantId, deliveryDate])
}

/// One return to the depot between two loads of a truck-day: back -> leave, by GPS and by the driver's
/// taps, and the cases loaded for the next load.
model FactDepotTurn {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The depot of the next load (where the truck was loaded).
  depotId            String
  deliveryDate       DateTime  @db.Date
  truckId            String
  truckCode          String
  afterLoadNo        Int
  nextLoadNo         Int
  backGpsAt          DateTime? @db.Timestamptz(3)
  leaveGpsAt         DateTime? @db.Timestamptz(3)
  turnMinGps         Float?
  backTapAt          DateTime? @db.Timestamptz(3)
  leaveTapAt         DateTime? @db.Timestamptz(3)
  turnMinTaps        Float?
  casesLoaded        Int
  /// The plan: the next departure minus the return before (minutes).
  plannedTurnMin     Int?
  minPerCaseLoading  Float?
  serviceMinPerCase  Float
  reloadMinutes      Int
  loadingMinPerCase  Float
  stopRadiusM        Int
  dwellMin           Int
  detectorVersion    String
  analysisVersion    String
  builtAt            DateTime  @db.Timestamptz(3)
  gpsBuiltAt         DateTime? @db.Timestamptz(3)
  refreshedAt        DateTime  @db.Timestamptz(3)
  frozenAt           DateTime? @db.Timestamptz(3)

  @@unique([tenantId, depotId, deliveryDate, truckId, afterLoadNo])
  @@index([tenantId, deliveryDate])
}
