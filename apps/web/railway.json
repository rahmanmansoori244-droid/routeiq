{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @routeiq/web build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @routeiq/web db:migrate:deploy",
    "startCommand": "pnpm --filter @routeiq/web start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
