# ---- Web (apps/web) ----

# Postgres connection string (Railway provides this in production)
DATABASE_URL=postgresql://routeiq:routeiq@localhost:5432/routeiq?schema=public

# NextAuth
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Solver service (Railway internal DNS in prod: http://routeiq-solver.railway.internal:8000)
SOLVER_URL=http://localhost:8000
SOLVER_TOKEN=replace_with_shared_secret

# Road routing for the dispatch planner (solver reads it; the web's legacy Map tab too). Self-hosted
# OSRM in production - see docs/OSRM_SETUP.md. Empty = plans use straight-line x 1.3 and are
# labelled "Estimated km". There is no default server: never point this at a public demo server,
# it would receive customer coordinates.
OSRM_URL=

# Optional (tests / debugging only): solve every plan scenario inside the solver's API process
# instead of worker processes. /health does not answer while it solves.
# SOLVER_PARALLEL=0

# Optional: concurrent dispatch solves (default 2 each). Solver: more are refused with 503.
# Web: more wait in a queue. Size to the solver's CPUs; keep the web value <= the solver value.
# MAX_CONCURRENT_DISPATCH=2
# SOLVER_MAX_CONCURRENT=2

# Local integration tests: disable in-memory rate limits on the dev server.
# Ignored on Railway (limits stay on) and logged as an error on any other production server.
# RATE_LIMITS_DISABLED=1

# Client IP for rate limits and audit rows: how many proxies append to X-Forwarded-For (default 1),
# or a single-value header the edge sets (for example x-real-ip). See apps/web/lib/client-ip.ts.
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=

# Cron janitor token for /api/cron/janitor. Production accepts only this token (never SOLVER_TOKEN);
# local dev falls back to SOLVER_TOKEN.
JANITOR_TOKEN=

# Mapbox (optional; maps are MapLibre + OpenStreetMap without it)
MAPBOX_TOKEN=

# Email (password reset) — Resend. Without it production sends NO reset links and /forgot says so;
# tenant admins then reset passwords on the Users screen ("Reset password": a new one-time
# password). RESEND_FROM must be a verified sender. Links use AUTH_URL, else NEXTAUTH_URL.
RESEND_API_KEY=
# RESEND_FROM=RouteIQ <noreply@your-domain>
# AUTH_URL=https://your-routeiq-domain

# Public sign-up: open by default; set to closed to turn it off. Sign-up always creates a
# TENANT_ADMIN of the new company.
# SIGNUP_MODE=closed

# Platform admins (SUPER_ADMIN): comma-separated emails. On its own this grants nothing - the owner
# also runs apps/web/prisma/grant-platform-admin.ts <email>; both are needed.
SUPER_ADMIN_EMAILS=

# Sentry
SENTRY_DSN=

# ---- Solver (apps/solver) ----
# Same SOLVER_TOKEN as web; OSRM_URL (above) is read by the solver
# PORT=8000
