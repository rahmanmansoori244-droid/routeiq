# ---- Web (apps/web) ----

# Postgres connection string (Railway provides this in production)
DATABASE_URL=postgresql://routeiq:routeiq@localhost:5432/routeiq?schema=public

# NextAuth
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Solver service (Railway internal DNS in prod: http://routeiq-solver.railway.internal:8000)
SOLVER_URL=http://localhost:8000
SOLVER_TOKEN=replace_with_shared_secret

# Road routing for the dispatch planner (solver reads it). Self-hosted OSRM in production -
# see docs/OSRM_SETUP.md. Empty = plans use straight-line x 1.3 and are labelled "Estimated km".
# https://router.project-osrm.org is a public DEMO server: local demos only.
OSRM_URL=

# Optional: solve plan alternatives sequentially instead of in worker processes
# SOLVER_PARALLEL=0

# Local integration tests: disable in-memory rate limits on the dev server
# RATE_LIMITS_DISABLED=1

# Cron janitor token (falls back to SOLVER_TOKEN)
JANITOR_TOKEN=

# Mapbox (optional; maps are MapLibre + OpenStreetMap without it)
MAPBOX_TOKEN=

# Email (password reset) — Resend by default
RESEND_API_KEY=

# Super-admin allowlist (comma-separated emails)
SUPER_ADMIN_EMAILS=

# Sentry
SENTRY_DSN=

# ---- Solver (apps/solver) ----
# Same SOLVER_TOKEN as web; OSRM_URL (above) is read by the solver
# PORT=8000
